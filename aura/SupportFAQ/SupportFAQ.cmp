<aura:component controller="SupportFAQCntrlr" implements="flexipage:availableForAllPageTypes,forceCommunity:availableForAllPageTypes" access="global" >
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="Knowledge" type="List" default=""/>
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="record" type="Object" />
    <aura:attribute name="whichOpen" type="Integer"/>
    <aura:attribute name="currentUser" type="Object" />
    <force:recordData
                      fields="FirstName,Account.Name,Account.Branding__c"
                      recordId="{!$SObjectType.CurrentUser.Id}"
                      targetFields="{!v.currentUser}"
                      mode="VIEW"
                      />
    <aura:if isTrue="{!not(empty(!v.Knowledge))}">
        
        <div class="slds-border_bottom ">
            <div class=" slds-p-top_large slds-p-bottom_small " >
                
                <aura:if isTrue="{!v.currentUser.Account.Branding__c !='Transport Funding'}">
                    <div class="heading" >
                        {!$Label.c.FAQs}
                    </div>
                    <aura:set attribute="else">
                        <div class="transport" >
                            {!$Label.c.FAQs}
                        </div>
                    </aura:set>
                </aura:if>
            </div>
        </div>
        <div class="slds-scrollable_y" style="height:13.5rem;width:28rem">
            <!--lightning:accordion class="sizee">
                <aura:iteration items="{!v.Knowledge}" var="know">
                    <lightning:accordionSection name="{!know.Question__c}" label="{!know.Question__c}">
                        <aura:set attribute="body">
                            <p><aura:unescapedHtml value="{!know.Answer__c}" /></p>
                        </aura:set>
                    </lightning:accordionSection>
                </aura:iteration>
            </lightning:accordion-->
            
            <ul class="slds-accordion">
                <aura:iteration items="{!v.Knowledge}" var="know" indexVar="index">
                    <li class="slds-accordion__list-item">
                        <section class="slds-accordion__section" aura:id="{!index}" id="{!index}" onclick="{!c.handleClick}">
                            <div class="slds-accordion__summary">
                                <h3 class="slds-accordion__summary-heading">
                                    <button aria-expanded="false" class="slds-button slds-button_reset slds-accordion__summary-action">
                                        <lightning:icon iconName="{!((v.whichOpen == index)?'utility:chevrondown':'utility:chevronright')}" size="x-small" alternativeText="Approved" />
                                        <span class="slds-truncate" title="{!know.Question__c}">{!know.Question__c}</span>
                                    </button>
                                </h3>
                            </div>
                            <div class="slds-accordion__content slds-p-left_x-large"><aura:unescapedHtml value="{!know.Answer__c}"/></div>
                        </section>
                    </li>
                </aura:iteration>
            </ul>
        </div>   
        <div class="slds-border_bottom">
        </div> 
    </aura:if>
    
</aura:component>