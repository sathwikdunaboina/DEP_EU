<aura:component implements="forceCommunity:availableForAllPageTypes"  access="global" controller="EndOfTermController">  
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="record" type="Object" />
    <aura:attribute name="currentUser" type="Object" />
    <force:recordData
                      fields="FirstName,Account.Name,Account.Branding__c"
                      recordId="{!$SObjectType.CurrentUser.Id}"
                      targetFields="{!v.currentUser}"
                      mode="VIEW"
                      />
    <aura:attribute name="TotalContracts" type="string"/>
    <aura:attribute name="srcValue" type="string"/>
    <aura:attribute name="timeToTerm" type="string"/>
    <aura:attribute name="value" type="Integer"/>
    <aura:attribute name="color" type="Integer" default="0"/>
    <aura:attribute name="myMap" type="List[]" default="Object[]"/>
    <aura:attribute name="contractList" type="List[]" default="Object[]"/>
    <aura:attribute name="display" type="Boolean" default="false"/>
    <aura:attribute name="nearTermContracts" type="string"/>
    <aura:attribute name="data" type="string"/>
    <aura:handler name="change" value="{!v.display}" action="{!c.handleChange}"/>
    <lightning:helptext class="slds-float_right slds-m-around_xx-small" content="{!$Label.c.Time_To_Term_Dashboard_Tooltip}"/>
    
    <div class="slds-card-wrapper" style="padding-top: 0rem !important;">
        <br/>
        <aura:if isTrue="{!v.currentUser.Account.Branding__c =='Renault'}">
            
            <div class="slds-page-header__title slds-truncate  ">
                <div class="heading">
                    {!$Label.c.End_of_Term}
                </div>
            </div>
            
            <aura:set attribute="else">
                <div class="slds-page-header__title slds-truncate ">
                    <div class="heading">
                        {!$Label.c.End_of_Term}
                    </div>
                </div>
                
            </aura:set>
        </aura:if>
        <article class="slds-card">
            <div class="slds-grid slds-wrap slds-p-bottom_small slds-p-top_small">
                <div class="slds-col slds-size_5-of-12 slds-max-small-size_1-of-1 ">
                    <span class="slds-p-left_small">{!v.TotalContracts}&nbsp; {!$Label.c.Total_Contracts}</span><br/>
                    <span class="slds-p-left_small">{!v.nearTermContracts}&nbsp;  {!$Label.c.Near_Term}</span>
                </div>
                <div class="slds-col slds-size_6-of-12 slds-max-small-size_1-of-1 chartStyle ">
                    <div class="slds-grid slds-wrap">
                        <iframe id="myFrame" style="height: 220px;width: 218px;border: hidden" src="{!v.srcValue}"/>
                    </div>
                </div>
            </div>
            
            <aura:if isTrue="{!v.currentUser.Account.Branding__c=='Renault'}">
                <div class="slds-grid slds-wrap leftspacing">
                    <!--div class="slds-col zIndex"> 
                        <lightning:icon onclick="{!c.callmodalforLightning}" aura:id="30" class="black"  size="xx-small" iconName="utility:record"/>
                        <span id="30" onclick="{!c.callmodal}">
                            {!$Label.c.X30_Days}
                        </span>
                    </div-->
                    <div class="slds-col zIndex"> 
                        <lightning:icon onclick="{!c.callmodalforLightning}" aura:id="3" class="gold" size="xx-small" iconName="utility:record"/>
                        <span id="3" onclick="{!c.callmodal}">
                            {!$Label.c.X3_Months}
                        </span>
                    </div>
                    <div class="slds-col zIndex">
                        <lightning:icon  onclick="{!c.callmodalforLightning}" aura:id="6" class="silver" size="xx-small" iconName="utility:record"/>
                        <span id="6" onclick="{!c.callmodal}">
                            {!$Label.c.X6_Months}
                        </span>
                    </div>
                </div>
                
                <aura:set attribute="else">
                    <div class="slds-grid slds-wrap leftspacing">
                        <!--div class="slds-col zIndex"> 
                                <lightning:icon onclick="{!c.callmodalforLightning}" aura:id="30" class="lightblue"  size="xx-small" iconName="utility:record"/>
                                <span id="30" onclick="{!c.callmodal}">
                                    {!$Label.c.X30_Days}
                                </span>
                            </div-->
                        <div class="slds-col zIndex"> 
                            <lightning:icon onclick="{!c.callmodalforLightning}" aura:id="3" class="gray" size="xx-small" iconName="utility:record"/>
                            <span id="3" onclick="{!c.callmodal}">
                                {!$Label.c.X3_Months}
                            </span>
                        </div>
                        <div class="slds-col zIndex">
                            <lightning:icon  onclick="{!c.callmodalforLightning}" aura:id="6" class="lightgray" size="xx-small" iconName="utility:record"/>
                            <span  id="6" onclick="{!c.callmodal}">
                                {!$Label.c.X6_Months}
                            </span>
                        </div>
                    </div>
                    
                    <!--aura:set attribute="else">
                            <div class="slds-grid slds-wrap leftspacing">
                                
                                <!- -div class="slds-col zIndex"> 
                                    <lightning:icon onclick="{!c.callmodalforLightning}" aura:id="30" class="blue"  size="xx-small" iconName="utility:record"/>
                                    <span id="30" onclick="{!c.callmodal}">
                                        {!$Label.c.X30_Days}
                                    </span>
                                </div- ->
                                <div class="slds-col zIndex"> 
                                    <lightning:icon onclick="{!c.callmodalforLightning}" aura:id="3" class="gray" size="xx-small" iconName="utility:record"/>
                                    <span id="3" onclick="{!c.callmodal}">
                                        {!$Label.c.X3_Months}
                                    </span>
                                </div>
                                <div class="slds-col zIndex">
                                    
                                    <lightning:icon  onclick="{!c.callmodalforLightning}" aura:id="6" class="lightgray" size="xx-small" iconName="utility:record"/>
                                    <span  id="6" onclick="{!c.callmodal}">
                                        {!$Label.c.X6_Months}
                                    </span>
                                </div>
                                
                            </div>
                        </aura:set-->
                </aura:set>
            </aura:if>
            
            <br/>
            <footer class="slds-m-top_x-small slds-p-top_xxx-small inMobile">
                <div class="slds-m-bottom--large slds-m-right--medium">
                    <a href="" onclick="{!c.navigatecontract}">{!$Label.c.View_All_Contracts}&nbsp;<lightning:icon iconName="utility:chevronright" size="xx-small" class="arrowColor vertAlign"/></a>
                </div>
            </footer>
        </article>
    </div>
    
    <aura:if isTrue="{!v.display}">
        <div class="demo-only" style="height: 640px;">
            <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                <div class="slds-modal__container">
                    <header class=" slds-modal__header">
                        <div class = 'heading'> 
                            <h2 id="modal-heading-01" class=" slds-hyphenate  slds-p-top_medium"> {!v.timeToTerm} Months To Term</h2>
                        </div>
                        <lightning:buttonIcon iconName="utility:close"
                                              onclick="{! c.closeTerm}"
                                              alternativeText="close"
                                              variant="bare-inverse"
                                              class="slds-modal__close"/>
                    </header>
                    <div class="slds-modal__content " id="modal-content-id-1 ">
                        <div class="slds-grid slds-wrap  slds-p-bottom_medium slds-p-top_medium slds-p-left_xx-large slds-p-right_xx-large slds-border--bottom">
                            <div class="slds-col slds-size_2-of-3  ">
                                Contract Number </div>
                            <div class="slds-col slds-size_1-of-3  ">
                                End Date </div>
                            <br/>
                        </div>
                        <aura:iteration items="{!v.myMap}" var="li" indexVar="index">
                            <div class="slds-grid slds-wrap slds-p-bottom_medium slds-p-top_medium slds-p-left_xx-large slds-p-right_xx-large slds-border--bottom">
                                <div class="slds-col slds-size_2-of-3  ">
                                    <a href="" id="{!li.Id}" onclick="{!c.contractDetail}">{!li.Name}</a></div>
                                <div class="slds-col slds-size_1-of-3 ">
                                    {!li.End_Date__c}</div>
                                <br/>
                            </div>
                        </aura:iteration>
                    </div>
                </div>
            </section>
            <div class="slds-backdrop slds-backdrop_open"></div>
        </div>
        
    </aura:if>
</aura:component>