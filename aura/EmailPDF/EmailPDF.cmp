<!--<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
	
</aura:component> -->

<aura:component implements="force:lightningQuickAction,force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId" access="global" controller = "EmailPdfController">
  
    <!-- Variables -->
    <aura:attribute name = 'recordId' type = 'Id' />
    <aura:attribute name = 'domain' type = 'String'/>
    
    <!-- Init -->
    <aura:handler name = "init" value = "{!this}" action = "{!c.doInit}"/>
    
	<!-- My CSS -->
	<aura:html tag="style">
        .slds-modal__content{
        overflow:visible !important;
        overflow-y:visible !important;
        
        }
        .slds-modal__container{
        max-width: 70rem !important;
        width: 80% !important;
        }
        .modal-body{
        max-height: 500px !important;
        height: 100% !important;
        }
        .cuf-content{
        padding: 0 0rem !important;
        }
        .slds-p-around--medium{
        padding: 0rem;
        }
        
    </aura:html> 
    
    <!-- Call VisualForce page -->
    <iframe src="{! v.domain + '/apex/EmailPDF?id=' + v.recordId }" width="100%" height="500px;" frameBorder="0"/>
    
</aura:component>