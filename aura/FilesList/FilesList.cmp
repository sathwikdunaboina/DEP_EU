<aura:component controller="DownloadFilesApexController" implements="forceCommunity:availableForAllPageTypes,force:hasRecordId">
    <aura:attribute name="fileList" type="DownloadFilesApexController.FileDetail[]"/>
    <aura:attribute name="contract" type="Object"/>
    <aura:attribute name="contractId" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.init}"/>
    <div class="slds-p-around_large">
        <ul class="slds-list_dotted">
            <aura:iteration items="{!v.fileList}" var="file">
                <li class="noLink"><a href="{!file.fileUrl}">{!file.fileName}</a></li>
            </aura:iteration> 
        </ul>
    </div>
</aura:component>