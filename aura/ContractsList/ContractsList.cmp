<aura:component description="ContractList" access="global" controller="ContracstListCntrlr" extends="c:AuraUtilities" implements="forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable">
    
    <aura:attribute name="top10Contracts" type="List" default="[]"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="contractId" type="String"/>
    <aura:attribute name="searchKeyword" type="String"/>
    <aura:attribute name="pageNumber" type="String" default="1" />
    <aura:attribute name="contracts" type="List" default="[]"/>
    <aura:attribute name="total" type="Integer" default="0"/>
    <aura:attribute name="status" type="String" default=""/>
    <aura:attribute name="order" type="String" default=""/>
    <aura:attribute name="sname" type="String" default=""/>
    <aura:attribute name="ad" type="String" default=""/>
    <aura:registerEvent name="pagination" type="c:PaginationEvt"/>
    <aura:handler event="c:PageChangeEvt" action="{!c.pageChange}" />
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="record" type="Object" />
    <aura:attribute name="currentUser" type="Object" />
    <force:recordData
                      fields="FirstName,Account.Name,Account.Branding__c"
                      recordId="{!$SObjectType.CurrentUser.Id}"
                      targetFields="{!v.currentUser}"
                      mode="VIEW"
                      />
    
    <div>
        <div>
            <div class="no-background ">
                <div class="slds-border_bottom">
                    <div class="slds-grid slds-wrap slds-grid_align-spread slds-wrap">
                        <aura:if isTrue="{!v.currentUser.Account.Branding__c =='Renault'}">
                            <div class="slds-col">
                                <div class="slds-p-top_large slds-p-bottom_x-small" >
                                    <div class="Renault">
                                        {!$Label.c.Contract_Summaries} 
                                    </div>
                                </div>
                            </div>
                            <aura:set attribute="else">
                                <div class="slds-col ">
                                    <div class="slds-p-top_large slds-p-bottom_x-small" >
                                        <div class="Volvo">
                                            {!$Label.c.Contract_Summaries} 
                                        </div>
                                    </div>
                                </div>   
                                                                
                               
                            </aura:set>
                        </aura:if>
                        
                        <aura:if isTrue="{!$Browser.isPhone}">
                            <div class="slds-col  slds-max-small-size_1-of-1">
                                <!--a onclick=""><lightning:icon class="sort-arrow" size="xx-small" iconName="utility:download" />{!$Label.c.Download_Contracts}</a-->
                                <!--c:ExportCSV aura:Id="export"/-->
                            </div>
                            <aura:set attribute="else">
                                <div class="slds-col slds-p-top_large slds-max-small-size_1-of-1">
                                    <!--a onclick=""><lightning:icon class="sort-arrow" size="xx-small" iconName="utility:download" />{!$Label.c.Download_Contracts}</a-->
                                    <!--c:ExportCSV aura:Id="export"/-->
                                </div>
                            </aura:set>
                        </aura:if> 
                    </div>
                    
                    <div>
                        <div class="slds-grid slds-grid_align-spread slds-wrap ">
                            <div class="slds-size_1-of-2 slds-max-small-size_1-of-1 slds-p-top_x-small">
                                <div class="contractstyle">
                                    <p>{!v.total}&nbsp;{!$Label.c.Total_Contracts} </p>
                                </div>
                                
                                <aura:if isTrue="{!$Browser.isPhone}">
                                    <div class="slds-form-element__control slds-p-top_medium slds-p-bottom_medium">
                                        <div class="slds-input-has-icon slds-input-has-icon--right" >
                                            <lightning:buttonIcon iconName="utility:search" variant="bare" onclick="{!c.handleClick}" alternativeText="Search" class="slds-input__icon" />
                                            <ui:inputText value="{!v.searchKeyword}" updateOn="keyup" keyup="{!c.handleEnterClick}" aura:id="search" class="slds-lookup__search-input slds-input " placeholder="{!$Label.c.Search_by_Contract_Number}" />
                                        </div>
                                    </div>  
                                </aura:if>
                                
                                <!--div class="sort">
                                    {!$Label.c.Sort_by}: &nbsp;
                                    <a onclick="{!c.sortByContractNumber}">
                                        {!$Label.c.Contract_Number} 
                                        <aura:if isTrue="{! and(v.order == 'Number', v.ad == 'ASC') }">
                                            <lightning:icon class="sort-arrow" size="xx-small" iconName="utility:chevronup"/>
                                        </aura:if>
                                        <aura:if isTrue="{! and(v.order == 'Number', v.ad == 'DESC') }">
                                            <lightning:icon class="sort-arrow" size="xx-small" iconName="utility:chevrondown"/>
                                        </aura:if>
                                    </a>
                                    | <a onclick="{!c.sortByDueDate}">
                                    {!$Label.c.Due_Date} 
                                    <aura:if isTrue="{! and(v.order == 'Due Date', v.ad == 'ASC') }">
                                        <lightning:icon class="sort-arrow" size="xx-small" iconName="utility:chevronup"/>
                                    </aura:if>
                                    <aura:if isTrue="{! and(v.order == 'Due Date', v.ad == 'DESC') }">
                                        <lightning:icon class="sort-arrow" size="xx-small" iconName="utility:chevrondown"/>
                                    </aura:if>
                                    </a>
                                    | <a onclick="{!c.sortByMaturityDate}">
                                    {!$Label.c.End_Date} 
                                    <aura:if isTrue="{! and(v.order == 'Maturity Date', v.ad == 'ASC') }">
                                        <lightning:icon class="sort-arrow" size="xx-small" iconName="utility:chevronup"/>
                                    </aura:if>
                                    <aura:if isTrue="{! and(v.order == 'Maturity Date', v.ad == 'DESC') }">
                                        <lightning:icon class="sort-arrow" size="xx-small" iconName="utility:chevrondown"/>
                                    </aura:if>
                                    </a>
                                </div-->
                            </div>
                            <aura:if isTrue="{!$Browser.isPhone}">
                                <aura:set attribute="else">
                                    <div class="slds-size_1-of-2 slds-max-small-size_1-of-1" >
                                        <div>
                                            <div class="slds-grid slds-grid_align-end">
                                                 
                                                <div class="slds-col">
                                                    <div class="slds-form-element__control">
                                                      
                                                        <div class="slds-input-has-icon slds-input-has-icon--right">
                                                            
                                                            <lightning:buttonIcon iconName="utility:search" variant="bare" onclick="{!c.handleClick }" alternativeText="Search" class="slds-input__icon" />
                                                            <ui:inputText value="{!v.searchKeyword}" updateOn="keyup" keyup="{!c.handleEnterClick}" aura:id="search" class="slds-lookup__search-input slds-input " placeholder="{!$Label.c.Search_by_Contract_Number}" />
                                                        </div>
                                                    </div>
                                                    <div class="slds-p-top_x-small" >
                                                        <aura:if isTrue="{!this}">
                                                            <aura:if isTrue="{!not(empty(v.contracts))}">
                                                                <c:Pagination sname="contract" contractId="{!v.contractId}"/>
                                                            </aura:if>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </aura:set> 
                            </aura:if>
                        </div> 
                    </div>
                </div>
                
                <ul class="slds-has-dividers_bottom-space">
                    <aura:if isTrue="{!not(empty(v.contracts))}">
                        <aura:iteration items="{!v.contracts}" var="contract">
                            <li id="x" >
                                <c:ContractSummaryItem contract="{!contract}"/>
                            </li>
                        </aura:iteration>
                        <aura:set attribute="else">
                            <p>{!$Label.c.No_Matching_Records_to_Display} !!!!</p>                    
                        </aura:set>
                    </aura:if>
                </ul>
                
            </div>
            <div class="slds-grid slds-grid_align-end ">
                <div class="slds-col slds-p-top_x-small">
                    <aura:if isTrue="{!this}">
                        <aura:if isTrue="{!not(empty(v.contracts))}">
                            <c:Pagination sname="contract" contractId="{!v.contractId}"/>
                        </aura:if>
                    </aura:if>
                </div>
            </div>
        </div>
    </div>
    <span>&nbsp;</span>
</aura:component>