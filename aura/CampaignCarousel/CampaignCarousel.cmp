<aura:component implements="forceCommunity:availableForAllPageTypes" extends="c:AuraUtilities" access="global" controller="PortalCampaignCarouselController">
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="vfsCampaigns" type="VFS_Campaign__c[]"/>
    <aura:attribute name="transX" type="String" default="-0%"/>
    <aura:attribute name="currentIndex" type="Integer" default="0"/>
    <div class="slds-card-wrapper ">
        <aura:if isTrue="{!empty(v.vfsCampaigns)}">
            <div class="heading" >
                {!$Label.c.No_active_campaigns}
            </div>
        </aura:if>
        <div class=" slds-p-around_large slds-carousel Helvetica">
            <div class="slds-carousel__stage">
                <ul class="slds-carousel__indicators" role="tablist">
                    <aura:iteration items="{!v.vfsCampaigns}" var="camp" indexVar="index">
                        <li class="slds-carousel__indicator" role="presentation">
                            <a onclick="{!c.goToNotification}" id="{!'indicator-id-0'+index}" 
                               class="{!'slds-carousel__indicator-action ' + (index==v.currentIndex?'slds-is-active':'')}" href="javascript:void(0);" role="tab" 
                               tabindex="{!index==0?'0':'-1'}" aria-selected="true" aria-controls="{!'content-id-0'+index}" 
                               title="{!camp.Name}" data-value="{!index}">
                                <span class="slds-assistive-text">{!camp.Name}</span>
                            </a>
                        </li>
                    </aura:iteration>
                </ul>
                <div class="slds-carousel__panels" style="{!'transform:translateX('+v.transX+')'}" id="panleElmt">
                    <aura:iteration items="{!v.vfsCampaigns}" var="camp" indexVar="index">
                        <div id="{!'content-id-0'+index}" class="slds-carousel__panel" role="tabpanel" aria-hidden="false" aria-labelledby="{!'indicator-id-0'+index}">
                            <a href="javascript:void(0);" class="slds-carousel__panel-action slds-text-link_reset" tabindex="{!index==0?'0':'-1'}">
                                <div class="slds-carousel__image">
                                    <ui:outputRichText value="{!camp.Description__c}" />  
                                </div>
                                <div class="slds-carousel__content">
                                    {!camp.Name}
                                </div>
                            </a>
                        </div>
                    </aura:iteration>
                </div>
                <aura:if isTrue="{!not(empty(v.vfsCampaigns))}">
                    <a class="prev" onclick="{!c.previous}">&#10094;</a>
                    <a class="next slds-align_right" onclick="{!c.next}">&#10095;</a>
                </aura:if>
                <ul class="slds-carousel__indicators" role="tablist">
                    <aura:iteration items="{!v.vfsCampaigns}" var="camp" indexVar="index">
                        <li class="slds-carousel__indicator" role="presentation">
                            <a onclick="{!c.goToNotification}" id="{!'indicator-id-0'+index}" 
                               class="{!'slds-carousel__indicator-action ' + (index==v.currentIndex?'slds-is-active':'')}" href="javascript:void(0);" role="tab" 
                               tabindex="{!index==0?'0':'-1'}" aria-selected="true" aria-controls="{!'content-id-0'+index}" 
                               title="{!camp.Name}" data-value="{!index}">
                                <span class="slds-assistive-text">{!camp.Name}</span>
                            </a>
                        </li>
                    </aura:iteration>
                </ul>
            </div>
        </div>
    </div>
</aura:component>