<aura:component implements="forceCommunity:searchInterface" access="global" >
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="record" type="Object" />
    <aura:attribute name="currentUser" type="Object" />
   
    <force:recordData
                      fields="FirstName ,Account.Name,Account.Branding__c"
                      recordId="{!$SObjectType.CurrentUser.Id}"
                      targetFields="{!v.currentUser}"
                      mode="VIEW"
                      />
    
    <aura:if isTrue="{!$Browser.isPhone}">
        <aura:set attribute="else">
            <aura:if isTrue="{!v.currentUser.Account.Branding__c=='Renault'}">
                <div class="renault">
                    <div ><strong>{!$Label.c.Welcome_to_RTFS_Portal}</strong> </div>
                </div>
                <div class="accountStyleRenault">{!v.currentUser.Account.Name}<br/>{!v.currentUser.FirstName}</div>
                <aura:set attribute="else">
                    <div class="volvo">
                        <div ><strong>{!$Label.c.Welcome_to_VFS_Portal}&nbsp;</strong> </div>
                    </div>
                    <div class="accountStyleVolvo">{!v.currentUser.Account.Name} <br/>{!v.currentUser.FirstName}</div>
                </aura:set>
            </aura:if>
            
        </aura:set>
    </aura:if>
</aura:component>