<apex:page id="MedAcctDriversChart" standardController="Account" extensions="medallia_xm.LightningOutExtension" 
            showHeader="false" sideBar="false" tabStyle="Account" label="Medallia Driver Insights" >
    <apex:includeLightning />

    <div id="medAcctDriversChart"></div>
    <script>
        var recordId = "{! $CurrentPage.parameters.id }";

        // Determine Classic or Lightning Experience
        var userContext = "{!$User.UITheme}";
        var isLightning = userContext == 'Theme3'

        $Lightning.use("{!ns}:MedAcctDriversChartApp", function () {

            $Lightning.createComponent('{!ns}:MedAcctDriversChart',
                {
                    recordId: recordId,
                    isLightning:isLightning,
                    chartLabel: "Selected Drivers Over Time",
                    selectedDateRange: "past6mo",
                    displayDriver1: "true",
                    displayDriver2: "true",
                    displayDriver3: "true",
                    displayDriver4: "true",
                    displayDriver5: "true",
                    displayDriver6: "true",
                    displayDriver7: "true",
                    displayDriver8: "true"
                },
                "medAcctDriversChart",
                function (component) {
                    //supporting setup
                });
        });
    </script>
</apex:page>