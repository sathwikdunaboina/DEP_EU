<apex:page standardController="Contact" extensions="medallia_xm.LightningOutExtension" label="Medallia Add To Program Dialog Detail" >
  <apex:includeLightning />
  <apex:includeScript value="/lightning/lightning.out.js" />
  <div id="myDivId"></div>
  <style>
    body,
    html {
      padding: 0!important;
    }

  </style>
  <script>   
    var recordId = "{! $CurrentPage.parameters.id }";
    var classicContactUrl = '{!URLFOR($Action.Contact.List, $ObjectType.Contact)}';

    // Determine Classic or Lightning Experience
    var isLightning = typeof sforce !== 'undefined' && sforce.one && true;

    $Lightning.use("{!ns}:MedAddToProgramDialogApp", function () {
      //$Lightning.createComponent(String type, Object attributes, String locator, function callback) */
      $Lightning.createComponent("{!ns}:MedAddToProgramDialog",
        {
          view: 'detail',
          selectedIds: [recordId],
          recordId: recordId,
          isLightning: isLightning,
          classicOriginUrl: classicContactUrl,
          origin: 'Contact',
        },
        "myDivId",
        function (component) {
          // supporting setup
        });
    });
  </script>
</apex:page>