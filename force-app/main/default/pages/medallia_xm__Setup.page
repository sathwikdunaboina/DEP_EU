<apex:page controller="medallia_xm.SetupController" standardStylesheets="false" sidebar="false" docType="html-5.0" cache="false" lightningStylesheets="true">
    <apex:slds />
    <script>
        var setup = (function () {
            // Private properties
            var oAuthWindow,
                oAuthWindowInterval,
                modalWrapperElements,
                overlay,
                modal,
                contentWrapper;
            init();

            // Revealing Module pattern
            return {
                openOAuthWindow: openOAuthWindow,
                closeOAuthWindow: closeOAuthWindow
            }
            // Public methods
            function openOAuthWindow() {
                if (oAuthWindow) {
                    closeOAuthWindow();
                }
                showModal();
                showOAuthWindow();
            }
            function closeOAuthWindow() {
                if (oAuthWindow) {
                    clearInterval(oAuthWindowInterval);
                    oAuthWindow.close();
                    oAuthWindow = undefined;
                }
                hideModal();
            }
            // Private methods
            function init() {
                // On Load...
                document.addEventListener("DOMContentLoaded", function () {
                    // Move the modal elements to the end of the body, so we can take it out of the contentWrapper div, so we can apply a blur to the contentWrapper
                    modalWrapperElements = ['overlayWrapper', 'modalWrapper'].map(function (id) {
                        return document.getElementById(id);
                    }).map(function (element) {
                        return document.body.appendChild(element);
                    });
                    // Assign commonly used elements to scoped variables
                    overlay = document.getElementById('overlay');
                    modal = document.getElementById('modal');
                    contentWrapper = document.getElementById('contentWrapper');
                });
            }
            function showModal() {
                modalWrapperElements.forEach(function (element) {
                    element.className += ' open';
                });
                overlay.className += ' slds-backdrop--open';
                modal.className += ' slds-fade-in-open';
                contentWrapper.className += ' blur';
                // For Accessibility
                modal.setAttribute("aria-hidden", "false");
                contentWrapper.setAttribute("aria-hidden", "true");
            }
            function hideModal() {
                modalWrapperElements.forEach(function (element) {
                    element.className = element.className.replace(' open', '');
                });
                overlay.className = overlay.className.replace(' slds-backdrop--open', '');
                modal.className = modal.className.replace(' slds-fade-in-open', '');
                contentWrapper.className = contentWrapper.className.replace(' blur', '');
                // For Accessibility
                modal.setAttribute("aria-hidden", "true");
                contentWrapper.setAttribute("aria-hidden", "false");
            }
            function showOAuthWindow() {
                // Create and Open the oAuth window
                var posX = window.screenX + ((window.innerWidth / 2) - 300);
                var posY = window.screenY + ((window.innerHeight / 2) - 300);
                oAuthWindow = window.open('/apex/oAuth', '_blank', 'height=600, width=600, toolbar=no, titlebar=no, scrollbars=no, menubar=no, location=yes, left=' + posX + ', top=' + posY);

                // Create an interval that will hide the modal and open the app once the oAuth window closes 
                oAuthWindowInterval = setInterval(function () {
                    if (oAuthWindow.closed) {
                        hideModal();
                        window.location = '{!JSENCODE($CurrentPage.parameters.start)}';
                    }
                }, 1000);
                // minimum interval for Chrome using javascript in a window not focused is 1000 milliseconds, making it any shorter is unnecessary.
            }
            // End of Module
        })()
    </script>

    <style type="text/css">
        /* Initial state */

        #overlayWrapper {
            position: fixed;
            top: 0;
            left: 0;
            height: 0%;
            width: 0%;
            z-index: 9000;
        }

        #modalWrapper {
            position: fixed;
            top: 0;
            left: 0;
            height: 0%;
            width: 0%;
            overflow: hidden;
            z-index: 9001;
        }

        /* make overlay and modal show*/

        #overlayWrapper.open {
            height: 100%;
            width: 100%;
        }

        #modalWrapper.open {
            -ms-transform: translate(0, -20px);
            /* IE 9 */
            -webkit-transform: translate(0, -20px);
            /* Chrome, Safari, Opera */
            transform: translate(0, -20px);
            -webkit-transition: transform .5s linear;
            /* Safari 3.1 to 6.0 */
            transition: transform .5s linear;
            height: 100%;
            width: 100%;
        }

        /* Blur classes */

        .blur {
            -webkit-filter: blur(2px);
            -moz-filter: blur(2px);
            -o-filter: blur(2px);
            -ms-filter: blur(2px);
            filter: blur(2px);
        }

        .noblur {
            -webkit-filter: blur(0px);
            -moz-filter: blur(0px);
            -o-filter: blur(0px);
            -ms-filter: blur(0px);
            filter: blur(0px);
        }

        /* Fixes for Aloha */

        td.noSidebarCell {
            padding: 0;
        }

        div.app {
            padding: 0 15px;
        }
    </style>

    <!-- REQUIRED SLDS WRAPPER -->
    <div class="slds">
        <!-- MASTHEAD -->
        <div class="slds-page-header">
            <div class="slds-text-heading--medium">
                Medallia Setup
            </div>
        </div>
        <br/>
        <!-- / MASTHEAD -->

        <!-- PRIMARY CONTENT WRAPPER -->
        <div class="app">
            <apex:form id="form">
                <apex:pageMessages />
                <div class="slds-grid">
                    <div class="slds-col">
                        <div class="slds-text-heading--label">API Connection</div>
                        <br/>
                        <apex:outputPanel rendered="{!NOT(isLinked)}">
                            <div class="slds-form" style="width: 400px;">
                                <apex:outputPanel layout="none" rendered="{!hasMessages}">
                                    <div class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_error" role="alert">
                                        <span class="slds-assistive-text">error</span>
                                        <span class="slds-icon_container slds-icon-utility-error slds-m-right_x-small" title="Error">
                                            <svg class="slds-icon slds-icon_x-small" aria-hidden="true">
                                                <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="{!URLFOR($Asset.SLDS, '/assets/icons/utility-sprite/svg/symbols.svg#error')}"></use>
                                            </svg>
                                        </span>
                                        <h2>{!errorMessage}</h2>
                                    </div>
                                    <br/>
                                    <br/>
                                </apex:outputPanel>
                                <div id="urlWrapper" class="{!urlFormClass}">
                                    <p>Step 1 of 2: Enter these URLs and click the "Set URLs" button below.</p>
                                    <br/>
                                    <div class="slds-form-element slds-form-element_stacked" style="margin-bottom: .5rem;">
                                        <label class="slds-form-element__label" for="{!$Component.baseUrl}">Base URL</label>
                                        <div class="slds-form-element__control">
                                            <apex:inputText id="baseUrl" value="{!baseUrl}" styleClass="slds-input" html-placeholder="http://www.apiurl.com" />
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="slds-form-element slds-form-element_stacked" style="margin-bottom: .5rem;">
                                        <label class="slds-form-element__label" for="{!$Component.oAuthUrl}">oAuth Token URL</label>
                                        <div class="slds-form-element__control">
                                            <apex:inputText id="oauthUrl" value="{!oAuthUrl}" styleClass="slds-input" html-placeholder="http://www.apiurl.com" />
                                        </div>
                                    </div>
                                    <apex:commandButton value="Set URLs" action="{!updateUrls}" rerender="form" styleClass="slds-button slds-button--neutral"
                                    />
                                </div>
                            </div>
                            <div id="credWrapper" class="{!credFormClass}">
                                <p>Step 2 of 2: Enter your credentials and click the button below to connect to Medallia's API.</p>
                                <br/>
                                <div class="slds-form" style="width: 400px;">
                                    <div class="slds-form-element slds-form-element_stacked" style="margin-bottom: .5rem;">
                                        <label class="slds-form-element__label" for="{!$Component.username}">Client Id</label>
                                        <div class="slds-form-element__control">
                                            <apex:inputText id="username" value="{!username}" styleClass="slds-input" />
                                        </div>
                                    </div>
                                    <div class="slds-form-element slds-form-element_stacked" style="margin-bottom: .5rem;">
                                        <label class="slds-form-element__label" for="username">Client Secret</label>
                                        <div class="slds-form-element__control">
                                            <apex:inputSecret id="password" value="{!password}" styleClass="slds-input" />
                                        </div>
                                    </div>
                                </div>
                                <apex:commandButton value="Connect to Medallia" action="{!connect}" rerender="form" styleClass="slds-button slds-button--neutral" />
                                <apex:commandButton value="Back" action="{!showUrl}" rerender="form" styleClass="slds-button slds-button--neutral" />
                            </div>
                        </apex:outputPanel>

                        <apex:outputPanel rendered="{!isLinked}">
                            <p>You are connected to Medallia's API. To reconnect, click the 'Disconnect' button below.</p>
                            <br/>
                            <apex:commandButton value="Disconnect" action="{!disconnect}" styleClass="slds-button slds-button--neutral" />

                            <!-- SELECT ADD TO PROGRAM CONTACT FIELDSET -->
                            <hr />
                            <p>The Add To Program button on Contact and Account uses a Contact Fieldset to determine which fields to send to Medallia for Invitations. Please select the Fieldset to be used (The default is medalliaOutbound_CreateSurvey).</p>
                            <br/>
                            <div class="slds-form" style="width: 400px;">
                                <div class="slds-form-element slds-form-element_stacked" style="margin-bottom: .5rem;">
                                    <label class="slds-form-element__label" for="{!$Component.contactFieldset}">Add To Program Contact Fieldset</label>
                                    <div class="slds-form-element__control">
                                        <apex:selectList id="contactFieldset" value="{!selectedFieldset}" styleClass="slds-input" size="1">
                                            <apex:selectOptions value="{!fieldSetsForContact}"/>
                                        </apex:selectList>
                                    </div>
                                </div>
                            </div>
                            <apex:commandButton value="Save" action="{!saveFieldset}" rerender="form" styleClass="slds-button slds-button--neutral" />
                            <apex:commandButton value="Cancel" action="{!cancelFieldset}" rerender="form" styleClass="slds-button slds-button--neutral" />
                        </apex:outputPanel>
                    </div>
                </div>
            </apex:form>
        </div>
        <!-- / PRIMARY CONTENT WRAPPER -->

        <!-- MODAL -->
        <div id="modalWrapper" class="noblur slds">
            <div id="modal" aria-hidden="true" role="dialog" class="slds-modal">
                <div class="slds-modal__container slds-modal--prompt">
                    <div class="slds-modal__header slds-theme--info slds-theme--alert-texture">
                        <h2 class="slds-text-heading--medium">Connecting to API...</h2>
                    </div>
                    <div class="slds-modal__content">
                        <p>If a new window did not open, click
                            <a href="#" onclick="setup.openOAuthWindow();">here</a>.</p>
                    </div>
                    <div class="slds-modal__footer slds-theme--default">
                        <div class="slds-x-small-buttons--horizontal">
                            <button class="slds-button slds-button--neutral" onclick="setup.closeOAuthWindow();">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- / MODAL -->

        <!-- BACKDROP -->
        <div id="overlayWrapper" class="slds">
            <div id="overlay" class="slds-backdrop"></div>
        </div>
        <!-- / BACKDROP -->
    </div>
    <!-- / SLDS WRAPPER -->

    <script>
        if ({!canUseMetaDataAPI}) {
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.SetupController.getUndefinedRemoteSiteSettings}',
                function (result, event) {
                    console.log(result);
                    if (result.length > 0) {
                        console.log('RemoteSiteSettings not defined. Creating...');

                        for (var i = 0; i < result.length; i++) {
                            var binding = new XMLHttpRequest();
                            var request =
                                '<?xml version="1.0" encoding="utf-8"?>' +
                                '<env:Envelope xmlns:env="http://schemas.xmlsoap.org/soap/envelope/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">' +
                                '<env:Header>' +
                                '<urn:SessionHeader xmlns:urn="http://soap.sforce.com/2006/04/metadata">' +
                                '<urn:sessionId>{!$Api.Session_ID}</urn:sessionId>' +
                                '</urn:SessionHeader>' +
                                '</env:Header>' +
                                '<env:Body>' +
                                '<createMetadata xmlns="http://soap.sforce.com/2006/04/metadata">' +
                                '<metadata xsi:type="RemoteSiteSetting">' +
                                '<fullName>Salesforce_X_' + i + '</fullName>' +
                                '<description>The URL used to access this instance of Salesforce (eg "company-name.my.salesforce.com" if using mydomains otherwise "naXX.salesforce.com").</description>' +
                                '<disableProtocolSecurity>false</disableProtocolSecurity>' +
                                '<isActive>true</isActive>' +
                                '<url>' + result[i] + '</url>' +
                                '</metadata>' +
                                '</createMetadata>' +
                                '</env:Body>' +
                                '</env:Envelope>';
                            binding.open('POST', '/services/Soap/m/35.0');
                            binding.setRequestHeader('SOAPAction', '""');
                            binding.setRequestHeader('Content-Type', 'text/xml');
                            binding.onreadystatechange =
                                function () {
                                    if (this.readyState == 4) {
                                        var parser = new DOMParser();
                                        var doc = parser.parseFromString(this.response, 'application/xml');
                                        var errors = doc.getElementsByTagName('errors');
                                        var messageText = '';
                                        for (var errorIdx = 0; errorIdx < errors.length; errorIdx++) {
                                            messageText += errors.item(errorIdx).getElementsByTagName('message').item(0).innerHTML + '\n';
                                        }
                                        console.log(messageText);
                                        console.log('RemoteSiteSetting created.');
                                    }
                                }
                            binding.send(request);
                        }
                    } else {
                        console.log('RemoteSiteSettings already defined. Not setting any up.');
                    }
                }
            );
        }
    </script>
</apex:page>