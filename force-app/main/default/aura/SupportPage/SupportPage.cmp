<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes" access="global" >
    <aura:attribute name="currentUser" type="Object" />
    <aura:attribute name="createCaseSuccessMessage" type="String" />
    <force:recordData
                      fields="FirstName,Account.Name,Account.Branding__c"
                      recordId="{!$SObjectType.CurrentUser.Id}"
                      targetFields="{!v.currentUser}"
                      mode="VIEW"
                      />
    
    <div class="slds-grid slds-wrap slds-p-bottom_small">
        <div class="slds-col slds-size_7-of-12 slds-max-small-size_1-of-1 ">
            <div class="slds-p-right_large"><c:SupportContacts createCaseSuccessMessage="{!v.createCaseSuccessMessage}"/></div>
            <!--div class="slds-p-right_large slds-truncate "><c:IL_Notification/></div-->
        </div>
        <div class="slds-col slds-size_5-of-12 slds-max-small-size_1-of-1">
           
                <div class="slds-p-right_large" >
                   <!-- <aura:if isTrue="{!v.currentUser.Account.Branding__c !='Transport Funding'}">
                        <div class="{!v.currentUser.Account.Branding__c=='Mack' ? 'golden' : 'Helvetica-Bold'}" >
                            {!$Label.c.FAQs}
                        </div>
                        <aura:set attribute="else">
                            <div class="transport" >
                                {!$Label.c.FAQs}
                            </div>
                        </aura:set>
                    </aura:if> -->
                      <div><c:SupportFAQ/></div>
               
            </div> 
          <!--   <div><c:SupportFAQ/></div> -->
            <!--div class="slds-p-right_large"><c:SupportDocument/></div-->
        </div>
    </div>
    <span>&nbsp;</span>
</aura:component>