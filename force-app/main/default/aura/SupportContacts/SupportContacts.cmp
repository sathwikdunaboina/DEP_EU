<aura:component extends="c:AuraUtilities" controller="SupportContactsCntrlr" implements="flexipage:availableForAllPageTypes,forceCommunity:availableForAllPageTypes" access="global" >
    <aura:attribute name="error" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="createCaseSuccessMessage" type="String" default="{!$Label.c.Create_Case_Success_Message}"/>
    <aura:attribute name="mngr" type="Territory_Manager__c" default="{}"/>
    <!--ltng:require scripts="{!$Resource.chartjs}" afterScriptsLoaded="{!c.afterScriptsLoaded}"/-->
    <aura:attribute name="record" type="Object" />
    <aura:attribute name="currentUser" type="Object" />
    <aura:attribute name="ServiceList" type="String" />
    
    <force:recordData
                      fields="FirstName,Account.Name,Account.Branding__c"
                      recordId="{!$SObjectType.CurrentUser.Id}"
                      targetFields="{!v.currentUser}"
                      mode="VIEW"
                      />
    <div class="slds-border_bottom ">
        <div class=" slds-p-top_large slds-p-bottom_small" >
            <div class = 'heading'>
                {!$Label.c.Support} 
            </div>    
        </div>
    </div>
    
    <div class="slds-grid slds-wrap slds-p-top--large slds-p-bottom--large">
        <div class="slds-size_1-of-2 slds-max-small-size_1-of-2">
            <div class="sectionTitle">
                <lightning:icon  size="small" iconName="utility:call" />&nbsp;&nbsp; {!$Label.c.Service_Desk}
            </div>               
            <div class="slds-card__body slds-m-bottom_xxx-small">
                <div class="slds-grid slds-wrap">
                    <div class="slds-col slds-size_1-of-1">
                        <div class="slds-p-top_small">
                            <table>
                                <tr>
                                    <td>&nbsp;&nbsp;</td><td>{!$Label.c.Service_Desk_Address}:&nbsp;&nbsp;</td><td>{!v.ServiceList.Address__c}</td>
                                </tr>
                                <tr>
                                    <td>&nbsp;&nbsp;</td><td>{!$Label.c.Service_Desk_Phone}:&nbsp;&nbsp;</td><td>{!v.ServiceList.Contact_Number__c}</td>
                                </tr>
                                <tr>
                                    <td>&nbsp;&nbsp;</td><td>{!$Label.c.Service_Desk_EMail}:&nbsp;&nbsp;</td><td><a href="">{!v.ServiceList.E_Mail__c}</a></td>
                                </tr>
                                <tr>
                                    <td>&nbsp;&nbsp;</td><td>{!$Label.c.Service_Desk_Hours}:&nbsp;&nbsp;</td><td>{!v.ServiceList.Support_Hours__c}</td>
                                </tr>
                            </table>
                            <div class="slds-p-top_medium slds-align_absolute-center">
                                <a class="hyperlinkText" onclick="{! c.toCreateCase }"><lightning:icon class="sort-arrow" size="xx-small" iconName="utility:chat" />&nbsp;{!$Label.c.Submit_a_Case_to_Customer_Service}</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <aura:if isTrue="{!$Browser.isPhone}">           
            <div class="slds-size_1-of-2 slds-max-small-size_1-of-2">          
                <div class="sectionTitle">
                    <lightning:icon  size="small" iconName="utility:user"/>&nbsp;&nbsp;{!$Label.c.Territory_Manager}
                </div>
                <div class="slds-card__body slds-m-bottom_xxx-small">
                    <div class="slds-grid slds-wrap">
                        <div class="slds-col slds-size_1-of-1">
                            <div class="slds-p-top_small">
                                <aura:if isTrue="{! !empty(v.mngr.Name)}">  
                                    <table>
                                        <tr>
                                            <td>&nbsp;&nbsp;</td><td>{!$Label.c.Name}:&nbsp;&nbsp;</td><td>{!v.mngr.Name}</td>
                                        </tr>
                                        <tr>
                                            <td>&nbsp;&nbsp;</td><td>{!$Label.c.Service_Desk_Phone}:&nbsp;&nbsp;</td><td>{!v.mngr.Phone__c}</td>
                                        </tr>
                                        <tr>
                                            <td>&nbsp;&nbsp;</td><td>{!$Label.c.Service_Desk_EMail}:&nbsp;&nbsp;</td><td><a href="">{!v.mngr.Email__c}</a></td>
                                        </tr>
                                    </table>
                                    <aura:set attribute="else">
                                        <tr>
                                            <td>&nbsp;&nbsp;</td><td>{!$Label.c.No_Territory_Manager_Present}</td>
                                        </tr>
                                    </aura:set>
                                </aura:if> 
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <aura:set attribute="else">
                <div class="verticalLine" style="height: 180px;">
                    <div class="slds-p-left_medium">
                        <div class="slds-size_1-of-2 slds-max-small-size_1-of-2">  
                            <div class="sectionTitle">
                                &nbsp;&nbsp;<lightning:icon  size="small" iconName="utility:user" />&nbsp;&nbsp;{!$Label.c.Territory_Manager}
                            </div>  
                            <div class="slds-card__body slds-m-bottom_xxx-smal">
                                <div class="slds-grid slds-wrap">
                                    <div class="slds-col slds-size_1-of-1">
                                        <div class="slds-p-top_small">
                                            <aura:if isTrue="{! !empty(v.mngr.Name)}">   
                                                <table>
                                                    <tr>
                                                        <td>&nbsp;&nbsp;</td><td>{!$Label.c.Name}:&nbsp;&nbsp;</td><td>{!v.mngr.Name}</td>
                                                    </tr>
                                                    <tr>
                                                        <td>&nbsp;&nbsp;</td><td>{!$Label.c.Service_Desk_Phone}:&nbsp;&nbsp;</td><td>{!v.mngr.Phone__c}</td>
                                                    </tr>
                                                    <tr>
                                                        <td>&nbsp;&nbsp;</td><td>{!$Label.c.Service_Desk_EMail}:&nbsp;&nbsp;</td><td><a href="">{!v.mngr.Email__c}</a></td>
                                                    </tr>
                                                </table>
                                                <aura:set attribute="else">
                                                    <tr>
                                                        <td>&nbsp;&nbsp;</td><td>{!$Label.c.No_Territory_Manager_Present}</td>
                                                    </tr>
                                                </aura:set>
                                            </aura:if> 
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div> 
                    </div>
                </div>
            </aura:set>
        </aura:if>       
        
        <div class="slds-size_1-of-1  slds-p-top_medium slds-max-small-size_1-of-1">
            <div class="slds-border--bottom  slds-p-bottom_large"></div>
        </div>
    </div>
    <lightning:overlayLibrary aura:id="modal"/>
</aura:component>