<aura:component implements="force:lightningQuickActionWithoutHeader,force:hasRecordId" controller="FetchContractListController">
	<aura:handler name="init" value="{!this}" action="{!c.initialize}"/>
    <aura:attribute name="errormessage" default="" type="String"/>
    <aura:if isTrue="{!v.errormessage!=''}">
        <div class="slds-text-color_error slds-align_absolute-center">
            {!v.errormessage}
        </div>
        <aura:set attribute="else">
            <div class="spinnerHolder slds-align_absolute-center">
                <lightning:spinner alternativeText="Loading" size="large" class="slds-m-top_large slds-m-left_large"/>
            	<div class="slds-text-color_info slds-align_absolute-center">
                    Fetching details. Please wait...
                </div>
            </div>
        </aura:set>
    </aura:if>
</aura:component>