<aura:component access="global" controller="PaymentPlanListCntrlr" extends="c:AuraUtilities" implements="forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable">
    
    <aura:attribute name="paymentList" type="List" default="[]"/>
    <aura:attribute name="contractId" type="String"/>
    <aura:attribute name="variationName" type="String"/>
    <aura:attribute name="order" type="String" default=""/>
    <aura:attribute name="ad" type="String" default=""/>
    <aura:attribute name="search" type="String" default=""/>
    <aura:attribute name="pageNumber" type="String" default="1" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:handler event="c:PageChangeEvt" action="{!c.pageChange}" />
    <aura:attribute name="error" type="String"/>
    <aura:attribute name="sortByNumber" type="Boolean" default="false"/>
    <aura:attribute name="contractRecord" type="Contract__c"/>
    <aura:attribute name="simpleContractRecord" type="Contract__c"/>
    <force:recordData aura:id="contractForceView"
                      recordId="{!v.contractId}"
                      layoutType="FULL"
                      mode="VIEW"
                      targetRecord="{!v.contractRecord}"
                      targetFields="{!v.simpleContractRecord}"
                      targetError="{!v.error}"/>
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="record" type="Object" />
    <aura:attribute name="currentUser" type="Object" />
    <force:recordData fields="FirstName,Account.Name,Account.Branding__c"
                      recordId="{!$SObjectType.CurrentUser.Id}"
                      targetFields="{!v.currentUser}"
                      mode="VIEW"
                      />
    
    <div>
        <div>
            <aura:if isTrue="{!v.contractId!=''}">
                <div class="slds-border_bottom slds-wrap  slds-p-bottom_small">
                    <div >
                        <div class="slds-text-title_bold">
                            {!$Label.c.Contract_Number}:
                        </div>
                    </div>
                    <div >
                        <div class="">
                            <aura:if isTrue="{!v.currentUser.Account.Branding__c=='Renault'}">
                                <div class="slds-grid slds-gutters">
                                    <div class=" slds-col slds-size_2-of-3 ">
                                        <div class="Renault slds-text-heading_medium  slds-p-bottom_x-small">
                                            {!v.simpleContractRecord.Contract_Number__c}
                                        </div>
                                    </div>
                                    <aura:if isTrue="{!$Browser.isPhone}">
                                        <div class="slds-col slds-size_1-of-3 slds-clearfix">
                                    <div class="slds-float_right">
                                        <lightning:Icon iconName="utility:chevronleft" size="x-small" alternativeText="Back"  onclick="{!c.navigatecontract}" />
                                    </div>
                                </div>
                                        <aura:set attribute="else">
                                    <div class="slds-col slds-size_1-of-3 slds-clearfix">
                                        <div class="slds-float_right">
                                            <lightning:button  label="{!$Label.c.Back}" class="buttoncss" onclick="{!c.navigatecontract}"/>
                                        </div>
                                    </div></aura:set>
                                    </aura:if>
                                </div>
                                <aura:set attribute="else">
                                    <div class="slds-grid slds-gutters">
                                        <div class=" slds-col slds-size_2-of-3 ">
                                            <div class="Volvo slds-text-heading_medium  slds-p-bottom_x-small">
                                                {!v.simpleContractRecord.Contract_Number__c}
                                            </div>
                                        </div>
                                         <aura:if isTrue="{!$Browser.isPhone}">
                                        <div class="slds-col slds-size_1-of-3 slds-clearfix">
                                    <div class="slds-float_right">
                                        <lightning:Icon iconName="utility:chevronleft" size="x-small" alternativeText="Back"  onclick="{!c.navigatecontract}" />
                                    </div>
                                </div>
                                        <aura:set attribute="else">
                                    <div class="slds-col slds-size_1-of-3 slds-clearfix">
                                        <div class="slds-float_right">
                                            <lightning:button  label="{!$Label.c.Back}" class="buttoncss" onclick="{!c.navigatecontract}"/>
                                        </div>
                                    </div></aura:set>
                                    </aura:if>
                                    </div>
                                </aura:set>
                            </aura:if>
                        </div>
                    </div>
                </div>
            </aura:if>
            
            <div class="slds-border_bottom">
                <div class="slds-grid slds-wrap slds-grid_align-spread slds-wrap">
                    <aura:if isTrue="{!v.contractId!=''}">
                        <aura:if isTrue="{!$Browser.isPhone}">
                            <div class="slds-max-small-size_1-of-1 slds-p-top_small"><c:ContractMenu contractId="{!v.contractId}" /></div>
                            <aura:set attribute="else">
                                <div class="slds-p-top_medium slds-col">
                                    <aura:if isTrue="{!v.currentUser.Account.Branding__c=='Renault'}">
                                        <div class="Renault">
                                            {!$Label.c.Contract_Payment_Plan}
                                        </div>
                                        <aura:set attribute="else">
                                            <div class="Volvo">
                                                {!$Label.c.Contract_Payment_Plan}
                                            </div>
                                        </aura:set>
                                    </aura:if>
                                </div>
                            </aura:set>
                        </aura:if>
                        <div class="slds-col slds-p-top_medium">
                            <!--a onclick="{!c.doExport}"><lightning:icon class="sort-arrow" size="xx-small" iconName="utility:download" />{!$Label.c.Download_Full_Payment_History}</a>
                            <c:tc_exportCSV aura:Id="export"/-->
                        </div>
                        <aura:set attribute="else">
                            <div class="slds-p-bottom_x-small slds-p-top_large slds-col">
                                <aura:if isTrue="{!v.currentUser.Account.Branding__c =='Renault'}">
                                    <div class="Renault">
                                        {!$Label.c.Payment_Plan}
                                    </div>
                                    <aura:set attribute="else">
                                        <div class="Volvo">
                                            {!$Label.c.Payment_Plan}
                                        </div>
                                    </aura:set>
                                </aura:if>
                            </div>
                            
                            <aura:if isTrue="{!$Browser.isPhone}">
                                <div class="slds-col  slds-max-small-size_1-of-1">
                                    <!--a onclick="{!c.doExport}"><lightning:icon class="sort-arrow" size="xx-small" iconName="utility:download" />{!$Label.c.Download_Full_Payment_History}</a>
                                    <c:tc_exportCSV aura:Id="export"/-->
                                </div>
                                <aura:set attribute="else">
                                    <div class="slds-col slds-p-top_large slds-max-small-size_1-of-1">
                                        <!--a onclick="{!c.doExport}"><lightning:icon class="sort-arrow" size="xx-small" iconName="utility:download" />{!$Label.c.Download_Full_Payment_History}</a>
                                        <c:tc_exportCSV aura:Id="export"/-->
                                    </div>
                                </aura:set>
                            </aura:if>
                        </aura:set>
                    </aura:if>
                </div>
                
                <aura:if isTrue="{!$Browser.isPhone}">
                    <div class="slds-max-small-size_1-of-1">
                        <lightning:input type="text" placeholder="{!$Label.c.Search_Plan}" aura:id="search"/>
                    </div>
                    <div class="slds-grid slds-wrap slds-grid_align-spread">
                        <div class="slds-col slds-max-small-size_6-of-12 slds-p-right_small FromStyle">
                            <lightning:input type="date" placeholder="{!$Label.c.From+':'}" aura:id="from" id="from"/>
                        </div>
                        <div class="slds-col slds-max-small-size_5-of-12 slds-p-right_small ToStyle">
                            <lightning:input type="date" placeholder="{!$Label.c.To+':'}" aura:id="to"/>
                        </div>
                        <div class="slds-col slds-max-small-size_1-of-12 slds-p-top_large">
                            <lightning:icon class="redOnYellow " iconName="utility:search" size="medium" onclick="{!c.search}" />
                        </div>
                    </div>
                    <aura:set attribute="else">
                        <div class="slds-grid slds-wrap slds-gutters">
                            <div class="slds-col slds-size_1-of-4 slds-max-small-size_1-of-4 ">
                                <div class="">
                                    <lightning:input type="text" placeholder="{!$Label.c.Search_Plan}" aura:id="search"/>
                                </div>
                            </div>
                            <div class="slds-col slds-size_1-of-4 slds-max-small-size_1-of-4 ">
                                <div class="">
                                    <lightning:input type="date" placeholder="{!$Label.c.From}" aura:id="from"/>
                                </div>
                            </div>
                            <div class="slds-col slds-size_1-of-4 slds-max-small-size_1-of-4 ">
                                <div class="">
                                    <lightning:input type="date" placeholder="{!$Label.c.To}" aura:id="to"/>
                                </div>
                            </div>
                            <div class="slds-col slds-size_1-of-4 slds-max-small-size_1-of-4 ">
                                <div class="searchTop">
                                    <lightning:icon class="redOnYellow slds-m-left_large" iconName="utility:search" size="medium" onclick="{!c.search}" />
                                </div>
                            </div>
                        </div>
                    </aura:set>
                </aura:if>
                
                <div class="slds-size_1-of-1"> 
                    <div class="slds-grid slds-grid_align-spread">
                        <div class="slds-col">
                            <!--aura:if isTrue="{! v.contractId == ''}">
                                {!$Label.c.Sort_by}: &nbsp;
                                <a onclick="{!c.sortByContractNumber}">
                                    {!$Label.c.Contract_Number}
                                    <aura:if isTrue="{! and(v.order == 'Number', v.ad == 'ASC') }">
                                        <lightning:icon class="sort-arrow" size="xx-small" iconName="utility:chevronup"/>
                                    </aura:if>
                                    <aura:if isTrue="{! and(v.order == 'Number', v.ad == 'DESC') }">
                                        <lightning:icon class="sort-arrow" size="xx-small" iconName="utility:chevrondown"/>
                                    </aura:if>
                                </a>
                            </aura:if-->
                        </div>
                        
                        <aura:if isTrue="{!$Browser.isPhone}">
                            <aura:set attribute="else">
                                <div class="slds-col">
                                    <aura:if isTrue="{!this}">
                                        <c:Pagination sname="paymentPlan" contractId="{!v.contractId}"/>
                                    </aura:if>
                                </div>
                            </aura:set>
                        </aura:if>
                    </div>
                </div>
            </div>
            
            <ul class="slds-has-dividers_bottom-space ">
                <aura:iteration items="{!v.paymentList}" var="payment">
                    <li id="x">
                        <c:PaymentPlanSummaryItem paymentPlan="{!payment}"/>
                    </li>
                </aura:iteration>
            </ul>
            
            <div class="slds-size_1-of-1 slds-p-top_large"> 
                <div class="slds-grid slds-grid_align-end">
                    <div class="slds-col">
                        <aura:if isTrue="{!this}">
                            <c:Pagination sname="paymentPlan" contractId="{!v.contractId}"/>
                        </aura:if>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <span>&nbsp;</span>
</aura:component>