<aura:component extends="c:AuraUtilities">
    <aura:attribute name="paymentPlan" type="Payment_Plan__c"/>
    <aura:attribute name="error" type="String"/>
    <aura:attribute name="simpleContractRecord" type="Contract__c"/>
    <force:recordData aura:id="contractForceView"
                      recordId="{!v.paymentPlan.Contract__c}"
                      layoutType="FULL"
                      mode="VIEW"
                      targetFields="{!v.simpleContractRecord}"
                      targetError="{!v.error}"
                      />
    
    <div class="slds-grid slds-wrap slds-border_bottom">
        <div class="slds-col slds-size_3-of-12 slds-max-small-size_1-of-2 labelStyle slds-p-top_small">
        	<div>{!$Label.c.Contract_Number}:</div>
            <div>{!$Label.c.Term}:</div>
            <div>{!$Label.c.Due_Date}:</div>
            <div>{!$Label.c.Balance}:</div>
        </div>
        <div class="slds-col slds-size_3-of-12 slds-max-small-size_1-of-2 slds-p-top_small">
        	<div>{!v.simpleContractRecord.Contract_Number__c}&nbsp;</div>
        	<div>{!v.paymentPlan.Term__c}&nbsp;</div>			
            <div><ui:outputDate value="{!v.paymentPlan.Due_Date__c}" format="DD/MM/YYYY"/>&nbsp;</div>
            <div><ui:outputCurrency value="{!v.paymentPlan.Balance__c}"/></div>
        </div>
        <div class="slds-col slds-size_3-of-12 slds-max-small-size_1-of-2 labelStyle slds-p-top_small">
            <div>{!$Label.c.Interest}:</div>
            <div>{!$Label.c.Amount_To_Pay}:</div>
            <div>{!$Label.c.Amotization}:</div>
        </div>
        <div class="slds-col slds-size_3-of-12 slds-max-small-size_1-of-2 slds-p-top_small">
            <div><ui:outputCurrency value="{!v.paymentPlan.Interest__c}"/></div>
            <div><ui:outputCurrency value="{!v.paymentPlan.Amount_to_Pay__c}"/></div>
            <div><ui:outputCurrency value="{!v.paymentPlan.Amotization__c}"/></div>
        </div>
        <!--div class="slds-col slds-size_2-of-12 slds-max-small-size_1-of-2 labelStyle slds-p-top_small">
        	<div>{!$Label.c.Payment}:</div>
            <div>{!$Label.c.Taxes}:</div>
            <div>{!$Label.c.Misc}:</div>
            <div>{!$Label.c.Late_Charges}:</div>
        </div>
        <div class="slds-col slds-size_2-of-12 slds-max-small-size_1-of-2 slds-p-top_small">
        	<div><ui:outputCurrency value="{!v.payment.Payment__c}"/>&nbsp;</div>
            <div><ui:outputCurrency value="{!v.payment.Taxes__c}"/>&nbsp;</div>
            <div><ui:outputCurrency value="{!v.payment.Misc__c}"/>&nbsp;</div>
            <div> <ui:outputCurrency value="{!v.payment.Late_Charge__c}"/></div>
        </div-->
    </div>
</aura:component>