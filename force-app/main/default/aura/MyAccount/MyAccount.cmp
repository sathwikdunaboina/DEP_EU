<aura:component controller="MyAccountCntrlr" implements="flexipage:availableForAllPageTypes,forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable" access="global">
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="acct" type="Account" default="{}"/>
    <aura:attribute name="record" type="Object" />
    <aura:attribute name="currentUser" type="Object" />
    <force:recordData
                      fields="Name,Email"
                      recordId="{!$SObjectType.CurrentUser.Id}"
                      targetFields="{!v.currentUser}"
                      mode="VIEW"
                      />
    
    <div class="slds-card-wrapper Arial">
        <div class="slds-size_1-of-1  slds-max-small-size_1-of-1">
            <aura:if isTrue="{!v.currentUser.Account.Branding__c =='Renault'}">
                <div class="slds-page-header__title">
                    <div class="heading">
                        <b>&nbsp;&nbsp;{!$Label.c.My_Account}</b>
                    </div>
                </div> 
                <aura:set attribute="else">
                    <div class="slds-page-header__title">
                        <div class="heading">
                            <b>&nbsp;&nbsp;{!$Label.c.My_Account}</b>
                        </div>
                    </div>
                </aura:set>
            </aura:if>    
         
            <div class=" slds-m-bottom_xxx-small">
                <article class="slds-card">
                    <div class="slds-col slds-size_1-of-1">
                        <div class="slds-p-top_small">
                            
                            <table>
                                
                                <tr>
                                    <td>&nbsp;&nbsp;</td><td height= '30px;' width= '200px;'><b >{!$Label.c.Company_Name}:</b></td> 
                                    <td>
                                        {!v.acct.Name} 
                                    </td>
                                </tr>
                                
                                <tr>
                                    <td>&nbsp;&nbsp;</td><td height= '30px;'><b>{!$Label.c.Company_Registration}:</b></td>
                                    <td>
                                        {!v.acct.CompanyRegistrationNumber__c}
                                    </td>
                                </tr>
                                
                                <tr>
                                    <td>&nbsp;&nbsp;</td><td height= '30px;'><b>{!$Label.c.Name}:</b></td>
                                    <td>
                                        {!v.currentUser.Name}
                                    </td>
                                </tr>
                                
                                <tr>
                                    <td>&nbsp;&nbsp;</td><td height= '30px;'><b>{!$Label.c.Email}:</b></td>
                                    <td>
                                        {!v.currentUser.Email}
                                        
                                    </td>
                                </tr>
                                <tr >
                                    <td>&nbsp;&nbsp;</td><td height= '30px;'><b>{!$Label.c.Office_Address}:</b></td>
                                    <td>
                                        {!v.acct.BillingStreet}, {!v.acct.BillingCity}, 
                                    </td>
                                </tr>
                                <tr >
                                    <td>&nbsp;&nbsp;</td><td></td>
                                    
                                    <td>
                                        {!v.acct.BillingState},{!v.acct.BillingPostalCode},{!v.acct.BillingCountry}
                                    </td>
                                    
                                    
                                </tr>
                                
                                <tr>
                                    <td>&nbsp;&nbsp;</td><td height= '30px;'><b>{!$Label.c.Phone}:</b></td>
                                    <td>
                                        {!v.acct.Phone}
                                    </td>
                                </tr>
                                
                            </table>
                        </div>
                    </div>
                </article>
            </div>
            <!--  <div class="slds-grid slds-wrap slds-grid_align-end linkStyle">
            <div class="slds-col slds-max-small-size_2-of-3">
                <a onclick="{!c.doChangeRequest}" id="{!$Label.c.Early_Termination}">Request Changes</a>
            </div>
        </div> -->
        </div>
    </div>
    <!--<lightning:overlayLibrary aura:id="modal"/>-->
</aura:component>