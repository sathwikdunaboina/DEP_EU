<?xml version="1.0" encoding="UTF-8"?>
<EscalationRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <escalationRule>
        <fullName>Customer Case Escalation Rule</fullName>
        <active>true</active>
        <ruleEntry>
            <businessHoursSource>Case</businessHoursSource>
            <criteriaItems>
                <field>Case.CASE_AGE_DAY__c</field>
                <operation>equals</operation>
                <value>5</value>
            </criteriaItems>
            <escalationAction>
                <assignedTo>AT_CS_Operations</assignedTo>
                <assignedToType>Queue</assignedToType>
                <minutesToEscalation>120</minutesToEscalation>
                <notifyCaseOwner>false</notifyCaseOwner>
            </escalationAction>
            <escalationStartTime>CaseCreation</escalationStartTime>
        </ruleEntry>
    </escalationRule>
    <escalationRule>
        <fullName>Customer Case Escalation Rule1</fullName>
        <active>false</active>
    </escalationRule>
</EscalationRules>
