<?xml version="1.0"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
<apiVersion>62.0</apiVersion>
<description>Used for email input and sending email</description>
  <isExposed>true</isExposed>
  <targets>
    <target>lightning__FlowScreen</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightning__FlowScreen">
      <property name="emailBody" type="String" label="Email Body"/>
      <property name="contactIds" type="String[]" label="Selected Contact Ids List" />
      <property name="emailTemplateId" type="String" label="emailTemplateId" />
      
    </targetConfig>
  </targetConfigs>
  </LightningComponentBundle>