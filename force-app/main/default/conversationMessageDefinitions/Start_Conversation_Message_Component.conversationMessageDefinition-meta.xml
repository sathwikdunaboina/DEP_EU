<?xml version="1.0" encoding="UTF-8"?>
<ConversationMessageDefinition xmlns="http://soap.sforce.com/2006/04/metadata">
    <constants>
        <constantType>Title</constantType>
        <primitiveValues>
            <textValue>Hope you are doing good? How may I help you?</textValue>
            <type>Text</type>
        </primitiveValues>
    </constants>
    <description>This component sends auto response message when chat starts with customer</description>
    <label>Start Conversation Message Component</label>
    <language>en_US</language>
    <messageLayouts>
        <formatType>Text</formatType>
        <layoutItems>
            <collectionType>None</collectionType>
            <name>text</name>
            <primitiveValues>
                <formulaTemplate>{!$Constants.Title}</formulaTemplate>
                <type>FormulaTemplate</type>
            </primitiveValues>
        </layoutItems>
        <messageType>StaticContent</messageType>
    </messageLayouts>
    <type>AutoResponse</type>
</ConversationMessageDefinition>
