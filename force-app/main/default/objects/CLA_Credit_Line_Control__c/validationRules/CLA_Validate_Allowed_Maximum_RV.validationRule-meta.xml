<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CLA_Validate_Allowed_Maximum_RV</fullName>
    <active>true</active>
    <description>Percentage must be between 0 and 100%.</description>
    <errorConditionFormula>OR(
   CLA_Allowed_Maximum_RV_Percent__c &gt; 1.0,
   CLA_Allowed_Maximum_RV_Percent__c &lt; 0.0
)</errorConditionFormula>
    <errorDisplayField>CLA_Allowed_Maximum_RV_Percent__c</errorDisplayField>
    <errorMessage>Percentage must be between 0 and 100%.</errorMessage>
</ValidationRule>
