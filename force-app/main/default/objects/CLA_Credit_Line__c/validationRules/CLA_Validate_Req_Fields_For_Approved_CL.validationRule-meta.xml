<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CLA_Validate_Req_Fields_For_Approved_CL</fullName>
    <active>true</active>
    <description>Check required fields for status Approved. Activation Date has to be required for updating status to approved.</description>
    <errorConditionFormula>AND( TEXT(CLA_Status__c) = &apos;Approved&apos; , 
ISBLANK( CLA_Activation_Date__c )
)</errorConditionFormula>
    <errorDisplayField>CLA_Activation_Date__c</errorDisplayField>
    <errorMessage>Activation Date is required.</errorMessage>
</ValidationRule>
