<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CLA_Prevent_Negative_Approved_Limit</fullName>
    <active>true</active>
    <description>Prevent negative value in Approved Limit.</description>
    <errorConditionFormula>CLA_Approved_Limit__c  &lt; 0</errorConditionFormula>
    <errorDisplayField>CLA_Approved_Limit__c</errorDisplayField>
    <errorMessage>Negative value not allowed.</errorMessage>
</ValidationRule>
