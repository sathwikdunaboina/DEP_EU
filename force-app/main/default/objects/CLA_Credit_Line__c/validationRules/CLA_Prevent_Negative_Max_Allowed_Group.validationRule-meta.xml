<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CLA_Prevent_Negative_Max_Allowed_Group</fullName>
    <active>true</active>
    <description>Prevent negative value in Max Allowed Group Exposure.</description>
    <errorConditionFormula>CLA_Max_Allowed_Group_Exposure__c &lt; 0</errorConditionFormula>
    <errorDisplayField>CLA_Max_Allowed_Group_Exposure__c</errorDisplayField>
    <errorMessage>Negative value not allowed.</errorMessage>
</ValidationRule>
