    <fullName>medallia_xm__Allow_Multiple</fullName>
    <active>false</active>
    <description>Only Date Based Events can have the Allow Multiples field checked.</description>
    <errorConditionFormula>NOT(medallia_xm__Is_Date_Based_Event__c)  &amp;&amp;
