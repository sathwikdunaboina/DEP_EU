<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CLA_Validate_Drawn_Date_Format</fullName>
    <active>true</active>
    <description>Make sure Drawn Date is added in correct format and valid date is added.</description>
    <errorConditionFormula>NOT(
  REGEX(
    CLA_Drawn_Date__c,
    &quot;^(?:(?:(?:19|20)\\d{2})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:(?:19|20)(?:[02468][048]|[13579][26]))-02-29)(T.*)?$&quot;
  )
)</errorConditionFormula>
    <errorDisplayField>CLA_Drawn_Date__c</errorDisplayField>
    <errorMessage>Enter valid Drawn Date.</errorMessage>
</ValidationRule>
