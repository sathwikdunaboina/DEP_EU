<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>medallia_xm__Count_by_One_Only</fullName>
    <active>false</active>
    <errorConditionFormula>AND(medallia_xm__ErrorCount__c &lt;&gt; 0
            , medallia_xm__ErrorCount__c &lt;&gt; PRIORVALUE(medallia_xm__ErrorCount__c)+1
            , medallia_xm__ErrorCount__c &lt;&gt; PRIORVALUE(medallia_xm__ErrorCount__c))</errorConditionFormula>
    <errorDisplayField>medallia_xm__ErrorCount__c</errorDisplayField>
    <errorMessage>Error Count can only increment by 1.</errorMessage>
</ValidationRule>
