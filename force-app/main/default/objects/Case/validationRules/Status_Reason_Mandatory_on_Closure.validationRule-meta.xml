<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status_Reason_Mandatory_on_Closure</fullName>
    <active>true</active>
    <description>Status reason must be selected, when closing a case</description>
    <errorConditionFormula>NOT( $Permission.ByPassValidationRule) &amp;&amp;&apos;Closed&apos; == text(Status) &amp;&amp; isBlank(text(Status_Reason__c))</errorConditionFormula>
    <errorDisplayField>Status_Reason__c</errorDisplayField>
    <errorMessage>Case Status Reason is mandatory when closing a case</errorMessage>
</ValidationRule>
