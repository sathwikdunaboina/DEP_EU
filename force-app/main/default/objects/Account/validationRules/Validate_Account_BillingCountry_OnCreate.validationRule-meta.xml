<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Account_BillingCountry_OnCreate</fullName>
    <active>true</active>
    <description>Validates billing country upon manual account creation.</description>
    <errorConditionFormula>AND(ISNEW() ,ISBLANK(BillingCountry) , NOT(CONTAINS( $User.Username, $Label.Integration_User_DBB_Username )),NOT( $Permission.ByPassValidationRule )
)</errorConditionFormula>
    <errorDisplayField>BillingCountry</errorDisplayField>
    <errorMessage>Billing country is required.</errorMessage>
</ValidationRule>
