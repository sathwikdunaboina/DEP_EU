<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancelled_Read_Only_Opportunity</fullName>
    <active>true</active>
    <errorConditionFormula>TEXT(PRIORVALUE(StageName)) = &apos;Cancelled&apos; &amp;&amp;
NOT($Permission.ByPassValidationRule) &amp;&amp;
NOT( $Profile.Name =&apos;API Only&apos;) &amp;&amp;
NOT($Permission.Modify_Cancelled_Opportunity)</errorConditionFormula>
    <errorMessage>Cancelled Opportunity cannot be edited.</errorMessage>
</ValidationRule>
