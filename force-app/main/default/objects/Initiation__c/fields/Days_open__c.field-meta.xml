<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_open__c</fullName>
    <deprecated>false</deprecated>
    <description>Formula that calculates the number of days the initiation has been opened or the days it was open for it the initiation asset is complete</description>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL( Status__c , &quot;Closed&quot;), Record_Closed_Date__c - CreatedDate , NOW()-CreatedDate )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Days open</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
