<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CLA_Required_Partner_Name</fullName>
    <active>true</active>
    <description>Partner Name is required if Credit Security&apos;s Require Security Partner is checked.</description>
    <errorConditionFormula>AND(CLA_Credit_Security__r.CLA_Require_Security_Partner__c = TRUE , ISBLANK( CLA_Partner_Name__c ))</errorConditionFormula>
    <errorDisplayField>CLA_Partner_Name__c</errorDisplayField>
    <errorMessage>Complete this field.</errorMessage>
</ValidationRule>
