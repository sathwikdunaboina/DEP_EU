<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Open_Asset__c</fullName>
    <deprecated>false</deprecated>
    <description>Formula that calculates the number of days the asset has been opened or the days it was open for it the initiation asset is complete (isdelivered = TRUE)</description>
    <externalId>false</externalId>
    <formula>if( Is_delivered__c =false,NOW()- CreatedDate, Date_stamp_is_Delivered__c -DATEVALUE( CreatedDate ))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Days Open (Asset)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
