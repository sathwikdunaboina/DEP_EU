        <label>Check Credit Line Status</label>
        <locationX>732</locationX>
        <locationY>435</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Credit_Line_status_is_Approved_Suspended_Expiry</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Credit_Line_Record.CLA_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Credit_Line_Record.CLA_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Suspended</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Credit_Line_Record.CLA_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Expired</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Prevent_Deletion_Error</targetReference>
            </connector>
            <label>Credit Line status is Approved/Suspended/Expiry</label>
        </rules>
        <rules>
            <name>Credit_Line_Customer_is_Primary_Customer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CLA_Is_Primary__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Prevent_Deletion_Error</targetReference>
            </connector>
            <label>Credit Line Customer is Primary Customer</label>
        </rules>
    </decisions>
