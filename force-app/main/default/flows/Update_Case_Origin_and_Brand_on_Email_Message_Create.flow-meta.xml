<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Decision element to check whether Get Records contains any record from Brand Setting Custom metadata</description>
        <name>Check_if_Metadata_Records_are_Available</name>
        <label>Check if Metadata Records are Available</label>
        <locationX>616</locationX>
        <locationY>479</locationY>
        <defaultConnector>
            <targetReference>Update_Case_Origin_to_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Metadata_Record_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Custom_Metadata_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Brand_and_Origin_Field_in_Case</targetReference>
            </connector>
            <label>Metadata Record Present</label>
        </rules>
    </decisions>
    <description>Whenever email message is created, Update the Brand and Origin of related Case record based on the Custom metadata(Brand Setting)</description>
    <environments>Default</environments>
    <interviewLabel>Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Case Origin and Brand on Email Message Create</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the Records of the Custom Metadata &apos;Brand Setting</description>
        <name>Get_Custom_Metadata_Records</name>
        <label>Get Custom Metadata Records</label>
        <locationX>616</locationX>
        <locationY>371</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_Metadata_Records_are_Available</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email_Address__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ToAddress</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Brand_Setting__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Based on the Metadata Record Update Brand and Origin field of Case</description>
        <name>Update_Brand_and_Origin_Field_in_Case</name>
        <label>Update Brand and Origin Field in Case</label>
        <locationX>484</locationX>
        <locationY>587</locationY>
        <inputAssignments>
            <field>Brand__c</field>
            <value>
                <elementReference>Get_Custom_Metadata_Records.Brand_Value__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin</field>
            <value>
                <stringValue>Email</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Parent</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>If no metadata records present Update the Case Origin to Email</description>
        <name>Update_Case_Origin_to_Email</name>
        <label>Update Case Origin to Email</label>
        <locationX>748</locationX>
        <locationY>587</locationY>
        <inputAssignments>
            <field>Origin</field>
            <value>
                <stringValue>Email</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Parent</inputReference>
    </recordUpdates>
    <start>
        <locationX>490</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Get_Custom_Metadata_Records</targetReference>
        </connector>
        <filterFormula>AND(
  {!$Record.Incoming} = TRUE,
  ABS(
    (DATETIMEVALUE({!$Record.Parent.Last_Email_Message_Received_Date__c}) - DATETIMEVALUE({!$Record.Parent.CreatedDate})) * 86400
  ) &lt;= 600
)</filterFormula>
        <object>EmailMessage</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
