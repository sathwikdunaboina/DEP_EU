        <locationX>176</locationX>
        <locationY>194</locationY>
        <defaultConnector>
            <targetReference>GetDealerAccount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Execute</defaultConnectorLabel>
        <rules>
