    <recordCreates>
        <description>This element asynchronously creates the Error Log Platform Event based on the previous assignment element.</description>
        <name>CreateErrorLogPlatformEvent</name>
        <label>Create Error Log Platform Event</label>
        <locationX>770</locationX>
        <locationY>1130</locationY>
        <inputReference>ErrorLogEvent</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Retrieve DealerAccount Record based on the Dealer Id passed by the Lead Assignment Platform Event. Will be matched to the Customer ID on the Account. 

The second filter is that the Account should have a Salesforce User as a Territory Manager. If not, the Lead Owner will be set to the Unallocated Leads Queue</description>
        <name>GetDealerAccount</name>
        <label>Get Dealer Account</label>
        <locationX>374</locationX>
        <locationY>314</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>DetermineLeadOwner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>GCCustomerID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.DealerId__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>GCCustomerID__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>The Unallocated Leads Queue Name is stored in the Golden Copy Custom Settings. This element retrieves the corresponding Queue based on that name by querying the Group object.</description>
        <name>GetUnallocatedLeadsQueueId</name>
        <label>Get Unallocated Leads Queue Id</label>
        <locationX>506</locationX>
        <locationY>554</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SetOwnerToUnallocatedLeadsQueue</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Setup.VFSAdminCustomSettings__c.UnallocatedLeadsQueue__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
