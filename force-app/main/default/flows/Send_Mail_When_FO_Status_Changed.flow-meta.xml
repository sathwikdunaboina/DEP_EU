        <name>EmailBody</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.End_Customer_Name__c}={!$Record__Prior.End_Customer_Name__c}, &apos;&apos;,&apos; Dear User The customer Name for FO &apos;+{!$Record.Name}+&apos; Changed Perviously it was &apos; + {!$Record__Prior.End_Customer_Name__c} +&apos; Now it is &apos; +{!$Record.End_Customer_Name__c}  ) +
IF(TEXT({!$Record.Order_Status_Description__c})=TEXT({!$Record__Prior.Order_Status_Description__c}), &apos;&apos;,&apos; Dear User Status for FO &apos;+{!$Record.Name}+&apos; Is Changed &apos; )</expression>
    </formulas>
    <formulas>
