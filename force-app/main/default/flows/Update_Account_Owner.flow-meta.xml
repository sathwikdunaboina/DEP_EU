            <value>
                <elementReference>Loop_Through_Territory_Managers.User.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Group_Members</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign the derived Market to the Market variable</description>
        <name>Assign_Derived_Market</name>
        <label>Assign Derived Market</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>Market</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>DeriveMarket</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Retrieve_Group</targetReference>
        </connector>
    </assignments>
    <constants>
        <description>The name of the Dealer Account Record Type</description>
        <name>DealerAccountRecordType</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Dealer_Account</stringValue>
        </value>
    </constants>
    <constants>
        <description>Contains the Territory Manager Role name</description>
        <name>TerritoryManagerRole</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Territory_Manager</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Check if this is a dealer or customer account</description>
        <name>AccountType</name>
        <label>AccountType</label>
        <locationX>380</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Customer Account</defaultConnectorLabel>
        <rules>
            <name>Dealer_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>DealerAccountRecordTypeId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Derived_Market</targetReference>
            </connector>
            <label>Dealer Account</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check to see who is the Territory manager of the group</description>
        <name>Check_to_see_who_is_the_Territory_manager_of_the_group</name>
        <label>Check to see who is the Territory manager of the group</label>
        <locationX>842</locationX>
        <locationY>1187</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_Group_Members</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_this_the_TM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_Territory_Managers.User.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_Through_Group_Members.UserOrGroupId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_the_User_ID</targetReference>
            </connector>
            <label>Is this the TM?</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if we have a Territory Manager</description>
        <name>Territory_Manager_Check</name>
        <label>Territory Manager Check</label>
        <locationX>182</locationX>
        <locationY>1655</locationY>
        <defaultConnectorLabel>No Territory Manager</defaultConnectorLabel>
        <rules>
            <name>Establised_Territory_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TerritoryManager</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Owner</targetReference>
            </connector>
            <label>Establised Territory Manager</label>
        </rules>
    </decisions>
    <description>Update the Account Owner based on the Territory Manager established from the group (market) and role from AccountTeamMember</description>
    <environments>Default</environments>
    <formulas>
        <description>Derive a market value by using the country and brand on the account</description>
        <name>DeriveMarket</name>
        <dataType>String</dataType>
        <expression>{!$Record.BillingCountry} &amp; &apos;-&apos; &amp; TEXT({!$Record.Branding__c})</expression>
    </formulas>
    <interviewLabel>Update Account Owner {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Account Owner</label>
    <loops>
        <description>Loop Through Group Members</description>
        <name>Loop_Through_Group_Members</name>
        <label>Loop Through Group Members</label>
        <locationX>622</locationX>
        <locationY>1079</locationY>
        <collectionReference>GroupMembers</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_to_see_who_is_the_Territory_manager_of_the_group</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_Through_Territory_Managers</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Loop Through Territory Managers</description>
        <name>Loop_Through_Territory_Managers</name>
        <label>Loop Through Territory Managers</label>
        <locationX>182</locationX>
        <locationY>971</locationY>
        <collectionReference>Get_the_Account_Team_Territory_Manager</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Loop_Through_Group_Members</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Territory_Manager_Check</targetReference>
        </noMoreValuesConnector>
    </loops>
