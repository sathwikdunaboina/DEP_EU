    <decisions>
        <description>This element checks if the case reopen date is changed or not and updates the task according to it</description>
        <name>Check_if_case_closed_date_is_changed</name>
        <label>Check if case reopen date is changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Check_if</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Case_Reopen_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Task_Record</targetReference>
            </connector>
            <label>Outcome 1 of Check if</label>
        </rules>
        <rules>
            <name>Delete_The_Task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Reopen_Postpone_Action_Task.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Task_Record</targetReference>
            </connector>
            <label>Delete The Task</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Delete Task On Case {!$Flow.CurrentDateTime}</interviewLabel>
