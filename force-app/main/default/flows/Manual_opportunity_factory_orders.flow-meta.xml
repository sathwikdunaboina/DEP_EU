<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This flow creates factory orders which has basically asset ,dealer and customer information from manual opportunities which are created as part of manual leads</description>
    <environments>Default</environments>
    <interviewLabel>Manual opportunity factory orders {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Manual opportunity factory orders</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>This element creates factory order record from opportunity</description>
        <name>Create_factory_order_record</name>
        <label>Create factory order record</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <connector>
            <targetReference>Update_factory_order_reference</targetReference>
        </connector>
        <inputAssignments>
            <field>Axle_Arrangement__c</field>
            <value>
                <elementReference>$Record.Lead_Axle_Arrangement__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Brand__c</field>
            <value>
                <elementReference>$Record.Lead_Brand__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Chassis_Type__c</field>
            <value>
                <elementReference>$Record.Lead_Chassis_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Country__c</field>
            <value>
                <elementReference>$Record.Customer_Account__r.BillingCountryCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Dealer_Id__c</field>
            <value>
                <elementReference>$Record.Account.CustomerID__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Dealer_Number__c</field>
            <value>
                <elementReference>$Record.Account.Customer_Number__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EndCustomerVATNumber__c</field>
            <value>
                <elementReference>$Record.Customer_Account__r.VATNumber__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>End_Customer_City__c</field>
            <value>
                <elementReference>$Record.Customer_Account__r.BillingCity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>End_Customer_Name__c</field>
            <value>
                <elementReference>$Record.Customer_Account__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>End_Customer_Phone__c</field>
            <value>
                <elementReference>$Record.Customer_Account__r.Phone</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FO_Registration_Date__c</field>
            <value>
                <elementReference>$Record.Lead_Creation_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Finance_Opportunity__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Market_Type_1_5__c</field>
            <value>
                <elementReference>$Record.Lead_Model__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Order_Id__c</field>
            <value>
                <stringValue>Manual + {!$Record.Id}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>VIN_Number__c</field>
            <value>
                <elementReference>$Record.Lead_VIN_Number__c</elementReference>
            </value>
        </inputAssignments>
        <object>Factory_Order__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_factory_order_reference</name>
        <label>Update factory order reference</label>
        <locationX>308</locationX>
        <locationY>384</locationY>
        <inputAssignments>
            <field>Factory_Order__c</field>
            <value>
                <elementReference>Create_factory_order_record</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>1 OR 2 OR 3 OR 4 OR 5 OR 6 OR 7</filterLogic>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Personal contact</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Phone</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Email</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>volvoselected.com</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>End-of-term</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Personal contact</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Other</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Create_factory_order_record</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
