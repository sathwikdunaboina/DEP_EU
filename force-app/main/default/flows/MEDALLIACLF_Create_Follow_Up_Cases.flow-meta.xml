    <description>This flow is used in Salesforce to create follow-up cases when Medallia Responses are received.</description>
    <environments>Default</environments>
    <formulas>
        <description>This resource is used to transform alert country from Response object from medallia to case country</description>
        <name>AlertCountry</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.alert_country__c}=&apos;UK&apos;,&apos;United Kingdom&apos; ,{!$Record.alert_country__c})</expression>
    </formulas>
    <formulas>
        <description>This resource is used to get appropriate value to assign to Type field</description>
        <name>TypeValue</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.medallia_xm__Alert_Type__c}=&apos;Relationship - Contact Me&apos;,&apos;CLF – Relationship&apos;,
IF({!$Record.medallia_xm__Alert_Type__c}=&apos;Purchase - Contact Me&apos;,&apos;CLF – Purchase&apos;,
null))</expression>
    </formulas>
