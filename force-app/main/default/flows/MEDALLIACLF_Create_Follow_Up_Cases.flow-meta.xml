    <decisions>
        <description>This decision outcome is to check for response alert type to be purchase or relationship</description>
        <name>CheckforAlertType</name>
        <label>CheckforAlertType</label>
        <locationX>440</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>GetCaseRecordType</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Purchase</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.medallia_xm__Alert_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Purchase - Contact Me</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PurchaseVariableAssignment</targetReference>
            </connector>
            <label>Purchase</label>
        </rules>
        <rules>
            <name>Relationship</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.medallia_xm__Alert_Type__c</leftValueReference>
