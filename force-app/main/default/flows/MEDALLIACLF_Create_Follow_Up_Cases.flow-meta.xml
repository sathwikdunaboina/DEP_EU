                <rightValue>
                    <stringValue>Relationship - Contact Me</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RelationshipVariableAssignment</targetReference>
            </connector>
            <label>Relationship</label>
        </rules>
    </decisions>
