    <formulas>
        <name>EmailMessageBody</name>
        <dataType>String</dataType>
        <expression>&apos;Hello Customer,&apos; +BR()+
&apos;Thank you for contacting our Customer Service Team at VFS Financial Services.&apos;+BR()+
&apos;Your case number is: &apos;+{!CaseNumberOfNewlyCreatedCase}+&apos;:&apos;+{!NewlyCreatedCaseSubject}+ BR()+
&apos;We endeavour to respond to your query as quickly as possible, if the query is urgent please do not hesitate to contact us by&apos;+BR()+
&apos;telephone on +44 (0)1926 401203.&apos;+BR()+
&apos;Web Address: www.vfsco.com&apos;+BR()+
&apos;Please note our opening hours are 08:30 – 16:30 Monday to Friday (excluding bank holidays)&apos; +BR()</expression>
    </formulas>
    <formulas>
        <description>This is the value of incoming field from a email message</description>
        <name>Incoming</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record__Prior.Source:EmailMessage.Incoming}==null, true, {!$Record__Prior.Source:EmailMessage.Incoming})</expression>
    </formulas>
    <formulas>
        <description>Formula variable to get the Latest Email Message</description>
        <name>LatestEmailMessageTextBody</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_Latest_Email.TextBody}, FIND(&apos;From:&apos;, {!Get_Latest_Email.TextBody}) -1)</expression>
    </formulas>
    <formulas>
        <name>NewlyCreatedCaseSubject</name>
        <dataType>String</dataType>
        <expression>{!$Record__Prior.Subject}</expression>
    </formulas>
    <formulas>
        <name>RecipientMailAddress</name>
        <dataType>String</dataType>
        <expression>{!$Record__Prior.SuppliedEmail}</expression>
    </formulas>
