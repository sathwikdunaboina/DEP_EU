    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>If_a_Case_closed_More_than_14_days_or_not</targetReference>
        </connector>
        <filterFormula>AND(BEGINS({!$Record__Prior.CreatedBy.Username}, &quot;customerportal@integration&quot;), ISPICKVAL(PRIORVALUE({!$Record.Origin}), &quot;Web&quot;),ISPICKVAL(PRIORVALUE({!$Record.Status}), &quot;Closed&quot;))</filterFormula>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
