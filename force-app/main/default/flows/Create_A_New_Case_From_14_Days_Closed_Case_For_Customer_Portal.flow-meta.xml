    <decisions>
        <name>If_a_Case_closed_More_than_14_days_or_not</name>
        <label>If a Case closed More than 14 days or not</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>More_than_14_days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DaysFromClosure</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>15.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_a_New_Case</targetReference>
            </connector>
            <label>More than 14 days</label>
        </rules>
        <rules>
            <name>Less_than_14_days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DaysFromClosure</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>14.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reopen_Case</targetReference>
            </connector>
            <label>Less than 14 days</label>
        </rules>
    </decisions>
    <description>This flow is used to create a new case if customer updates a 14 days closed case and it will reopen the same case if customer updates closed case within 14 days.</description>
    <environments>Default</environments>
    <formulas>
        <name>CaseCommentBody</name>
        <dataType>String</dataType>
        <expression>&apos;New Case - &apos; +{!CaseNumberOfNewlyCreatedCase}+&apos; has been opened as the previous case &apos; +{!$Record__Prior.CaseNumber} +&apos; has been closed for more than 14 days.&apos;</expression>
    </formulas>
    <formulas>
        <name>CaseCommentbodyWhenReOpenCase</name>
        <dataType>String</dataType>
        <expression>&apos;Closed Case &apos;+{!$Record__Prior.CaseNumber}+&apos; has been Reopened.&apos;</expression>
    </formulas>
    <formulas>
        <name>DaysFromClosure</name>
        <dataType>Number</dataType>
        <expression>TODAY()-DATEVALUE({!$Record__Prior.ClosedDate})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>EmailMessageBody</name>
        <dataType>String</dataType>
        <expression>&apos;Hello Customer,&apos; &amp; BR() &amp;BR()&amp;

&apos;Thank you for contacting our Customer Service Team at VFS Financial Services.&apos; &amp; BR() &amp;
&apos;Your new case number is -  &apos; &amp;{!CaseNumberOfNewlyCreatedCase} &amp; &apos; related to your previous case -&apos; &amp;{!$Record__Prior.CaseNumber}&amp; BR()</expression>
    </formulas>
    <formulas>
        <name>ReceipientAddress</name>
        <dataType>String</dataType>
        <expression>{!$Record__Prior.ContactEmail}</expression>
    </formulas>
    <interviewLabel>Create A New Case From 14 Days Closed Case For Customer Portal {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create A New Case From 14 Days Closed Case For Customer Portal</label>
