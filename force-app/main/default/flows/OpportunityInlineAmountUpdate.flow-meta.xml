<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Decision to check if amount is changed or net sales price changed</description>
        <name>CheckForChange</name>
        <label>CheckForChange</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AmountChanged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Amount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateCustomFieldFromAmount</targetReference>
            </connector>
            <label>AmountChanged</label>
        </rules>
        <rules>
            <name>NetSalesPriceChanged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NetSalesPrice__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.NetSalesPrice__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateAmountFromCustomField</targetReference>
            </connector>
            <label>NetSalesPriceChanged</label>
        </rules>
    </decisions>
    <description>On creation or updating of opportunity record, once the record has amount field entered, there should be a possibility to directly modify the amount of an opportunity in the list view. As of now, this is not achievable through OOB in salesforce hence using custom field exclusively on list views and creation of bidirectional sync between custom field and standard amount field.
US#7589</description>
    <environments>Default</environments>
    <interviewLabel>OpportunityInlineAmountUpdate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>OpportunityInlineAmountUpdate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Update record action to update amount field from Custom field</description>
        <name>UpdateAmountFromCustomField</name>
        <label>UpdateAmountFromCustomField</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>$Record.NetSalesPrice__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Update action to update custom field Net sales price from Amount field</description>
        <name>UpdateCustomFieldFromAmount</name>
        <label>UpdateCustomFieldFromAmount</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>NetSalesPrice__c</field>
            <value>
                <elementReference>$Record.Amount</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CheckForChange</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Amount</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NetSalesPrice__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
