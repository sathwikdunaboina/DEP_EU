    <decisions>
        <name>Check_Urgent_Note_Count</name>
        <label>Check Urgent Note Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Urgent_Notes</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If No Urgent Notes available</defaultConnectorLabel>
        <rules>
            <name>If_more_than_one_urgent_note_available</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>ContractCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AccountCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetAccountUrgnetNoteText</targetReference>
            </connector>
            <label>If more than one urgent note available</label>
        </rules>
    </decisions>
