        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>NOTE_TYPE__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PERSON_ORGANIZATION_URGENT_NOTE</stringValue>
