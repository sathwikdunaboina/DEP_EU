<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Email_For_Case_Postpone_Task</name>
        <label>Send Email For Case Postpone Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Loop_over_task_record</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>TaskOwnerEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>OrgWideEmailAddress</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <stringValue>vfs.support.salesforce@volvo.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>composeEmailContent</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Case Reopen Task</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>Dear User,

Case Number {!Get_Case_Record_for_the_reopen_task.CaseNumber} has been reopened today. 
To proceed, please complete the associated task using the link below and then reopen the case: 

{!OrgBaseLink}/{!Loop_over_task_record.Id}/view 

Thank you for your prompt attention.

Regards,  
Service Connect Support Team
</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>1.0.1</versionString>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Case_Last_Modified_By_User_Email</name>
        <label>Case Last Modified By User Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>TaskOwnerEmail</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Case_Record_for_the_reopen_task.LastModifiedBy.Email</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Email_For_Case_Postpone_Task</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>User_Email_Assignment</name>
        <label>User Email Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>TaskOwnerEmail</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_over_task_record.Owner:User.Email</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Email_For_Case_Postpone_Task</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>This Decision Element Checks if the task owner is user or group</description>
        <name>Check_Task_Owner</name>
        <label>Check Task Owner Is User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Case_Last_Modified_By_User_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_task_owner_is_user_or_group</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_over_task_record.Owner:Group.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_over_task_record.Owner:User.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>User_Email_Assignment</targetReference>
            </connector>
            <label>Check if task owner is user or group</label>
        </rules>
    </decisions>
    <description>This flow sends the remainder mail to the owner of the case postpone action tasks</description>
    <environments>Default</environments>
    <formulas>
        <description>This resource is used to get the org base link</description>
        <name>OrgBaseLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_540}, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_540}) - 1) &amp; &quot;/lightning/r/Task&quot;</expression>
    </formulas>
    <formulas>
        <name>TodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Send Mail To Case Postpone Action {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Mail To Case Postpone Action Task Owner</label>
    <loops>
        <name>Loop_over_task_record</name>
        <label>Loop over task record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Case_Reopen_Tasks</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Case_Record_for_the_reopen_task</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Reopen_The_Cases_Marked_As_Postpone_Action</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Reopen_The_Cases_Marked_As_Postpone_Action</name>
        <label>Reopen The Cases Marked As Postpone Action</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetCasesMarkedAsPostponeReopen</collectionReference>
        <iterationOrder>Asc</iterationOrder>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Case_Record_for_the_reopen_task</name>
        <label>Get Case Record for the reopen task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Task_Owner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_over_task_record.WhatId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Case_Reopen_Tasks</name>
        <label>Get Case Reopen Tasks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_over_task_record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Case Postpone Action</stringValue>
            </value>
        </filters>
        <filters>
            <field>ActivityDate</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>TodayDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Cases_Marked_As_Postpone_Action</name>
        <label>Get Cases Marked As Postpone Action</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Case_Reopen_Tasks</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case_Reopen_Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>TodayDate</elementReference>
            </value>
        </filters>
        <object>Case</object>
        <outputReference>GetCasesMarkedAsPostponeReopen</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Cases_Marked_As_Postpone_Action</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-09-01</startDate>
            <startTime>11:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
