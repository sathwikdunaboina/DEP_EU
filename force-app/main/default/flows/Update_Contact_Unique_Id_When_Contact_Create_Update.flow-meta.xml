<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>When a Contact don&apos;t have any ContactId, update the ContactId using formula(Account.CustomerID__c + &quot;-&quot; + Contact.Email)</description>
    <environments>Default</environments>
    <formulas>
        <name>CalculateContactId</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account.CustomerID__c} + &quot;-&quot; +{!$Record.Email}</expression>
    </formulas>
    <interviewLabel>Update Contact Unique Id {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Contact Unique Id When Contact Create/Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>When a Contact don&apos;t have any ContactId, update the ContactId using formula(CalculateContactId)</description>
        <name>Update_Contact_Id</name>
        <label>Update Contact Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ContactId__c</field>
            <value>
                <elementReference>CalculateContactId</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Contact_Id</targetReference>
        </connector>
        <filterFormula>AND(
    NOT(ISBLANK({!$Record.Account.CustomerID__c})),
    NOT(ISBLANK({!$Record.Email})),
    OR(
        ISNEW(),
        ISCHANGED({!$Record.Email})
    )
)</filterFormula>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
