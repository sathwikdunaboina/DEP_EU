    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Decision to check whether the Org is Sandbox or Production</description>
        <name>Check_The_Organization_As_Production_Or_Sandbox</name>
        <label>Check The Organization As Production Or Sandbox</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Get_Record_Have_value</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_the_Organization_Where_the_Flow_Runs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_the_User_Profile_Need_To_Be_Included</targetReference>
            </connector>
            <label>Get Record Have value</label>
        </rules>
    </decisions>
    <decisions>
        <description>Decision to check whether the User Logged in, and if the Logged in Date is more than 60 or 90 Days</description>
        <name>To_Check_the_User_s_Logged_In_Date</name>
        <label>To Check the User&apos;s Logged In Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Users_Never_Logged_and_Logged_in_60_days_Ago</name>
            <conditionLogic>(1 AND 2) OR 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LastLoginDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CreatedDateDateValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>FormulaDate60DaysAgo</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LastLoginDateValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>FormulaDate60DaysAgo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_60_Days_Notification_To_User</targetReference>
            </connector>
            <label>Users Never Logged and Logged in 60 days Ago</label>
        </rules>
        <rules>
            <name>Users_Logged_in_But_Inactive_for_90_Days</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LastLoginDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CreatedDateDateValue</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>FormulaDate90DaysAgo</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LastLoginDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LastLoginDateValue</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>FormulaDate90DaysAgo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_90_Days_Notification_To_User</targetReference>
            </connector>
            <label>Users Logged in But Inactive for 90 Days</label>
        </rules>
    </decisions>
    <decisions>
        <description>Decision element to check User Profile to include for Deactivation</description>
        <name>To_Check_User_Profile</name>
        <label>To Check User Profile</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_User_Profile_Should_Be_Included</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_the_User_Profile_Need_To_Be_Included</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>To_Check_the_User_s_Logged_In_Date</targetReference>
            </connector>
            <label>If User Profile Should Be Included</label>
        </rules>
    </decisions>
    <description>Flow to deactivate User automatically when the User Never Logged in or Login Date is more than 90 days</description>
    <environments>Default</environments>
    <formulas>
        <description>Formula Resource to store the Date Value from Created Date(Date Time).</description>
        <name>CreatedDateDateValue</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.CreatedDate})</expression>
    </formulas>
    <formulas>
        <description>Email Message to send to User who haven&apos;t logged in for 60 days</description>
        <name>EmailMessageFor60Days</name>
        <dataType>String</dataType>
        <expression>&apos;Hi &apos;+{!$Record.FirstName}+&apos; &apos;+{!$Record.LastName}+&apos;,&apos;+BR()+
&apos;You have not logged into Salesforce for last 60 days.&apos; +BR()+
&apos;Your access will be automatically disabled if you have not logged into Salesforce for 90 days.&apos; +BR()+
&apos; &apos;+BR()+
&apos;Regards,&apos; +BR()+
&apos;VFS Salesforce Support&apos; +BR()</expression>
    </formulas>
    <formulas>
        <description>Email Message to send to User who haven&apos;t logged in for 90 days</description>
        <name>EmailMessageFor90Days</name>
        <dataType>String</dataType>
        <expression>&apos;Hi &apos;+{!$Record.FirstName}+&apos; &apos;+{!$Record.LastName}+&apos;,&apos;+BR()+
&apos;Your access to Salesforce platform has been disabled as you have not logged into the platform for last 90 days.&apos; +BR()+
&apos; &apos;+BR()+
&apos;Regards,&apos; +BR()+
&apos;VFS Salesforce Support&apos; +BR()</expression>
    </formulas>
    <formulas>
        <description>Formula Resource to Calculate 60 days from Today</description>
        <name>FormulaDate60DaysAgo</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 60</expression>
    </formulas>
    <formulas>
        <description>Formula Resource to Calculate 90 days from Today</description>
        <name>FormulaDate90DaysAgo</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 90</expression>
    </formulas>
    <formulas>
        <description>Formula Resource to store the Date Value from Last Login(Date Time).</description>
        <name>LastLoginDateValue</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.LastLoginDate})</expression>
    </formulas>
    <interviewLabel>User Deactivation Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>User Deactivation Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get Record Element to check if the flow is running in Production or Sandbox</description>
        <name>Get_the_Organization_Where_the_Flow_Runs</name>
        <label>Get the Organization Where the Flow Runs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_The_Organization_As_Production_Or_Sandbox</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsSandbox</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Organization</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get Record to get the Custom Metadata(UserProfileToIncludeForDeactivation) to Include Profile for Deactivation</description>
        <name>Get_the_User_Profile_Need_To_Be_Included</name>
        <label>Get the User Profile Need To Be Included</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>To_Check_User_Profile</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Profile_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Profile.Name</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UserProfileToIncludeForDeactivation__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Once the User Not logged into Org for 90 days make the User Inactive</description>
        <name>Update_the_User_to_Inactive</name>
        <label>Update the User to Inactive</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>IsActive</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_the_Organization_Where_the_Flow_Runs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>User</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-09-05</startDate>
            <startTime>05:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
