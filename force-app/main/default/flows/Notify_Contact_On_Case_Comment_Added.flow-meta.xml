<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>EmailMessage_Record_Variable</name>
        <label>EmailMessage Record Variable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>EmailMessageRecord.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EmailMessageRecord.FromAddress</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>FromAddress</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EmailMessageRecord.FromName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>FromName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EmailMessageRecord.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NotificationSubject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EmailMessageRecord.HtmlBody</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>EmailBodyFormatted</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EmailMessageRecord.ToAddress</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Recipient</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EmailMessageRecord.IsVisibleToCustomerPortal__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Notify_Case_Contact</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>This is to check whether the Case Source system is Customer Portal or Not</description>
        <name>Check_if_Case_Source_System_is_Customer_Portal</name>
        <label>Check if Case Source System is Customer Portal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.Source_System__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer Portal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.Origin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Portal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>EmailMessage_Record_Variable</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CaseCreatedbyUser</name>
        <dataType>String</dataType>
        <expression>{!$Record.Parent.CreatedBy.FirstName} + &apos; &apos;+{!$Record.Parent.CreatedBy.LastName}</expression>
    </formulas>
    <formulas>
        <name>FromAddress</name>
        <dataType>String</dataType>
        <expression>&quot;vfs.support.salesforce@volvo.com&quot;</expression>
    </formulas>
    <formulas>
        <name>FromName</name>
        <dataType>String</dataType>
        <expression>&quot;VFS Support Team&quot;</expression>
    </formulas>
    <formulas>
        <name>NotificationSubject</name>
        <dataType>String</dataType>
        <expression>{!$Record.Parent.CaseNumber} &amp; &quot; : New Case Comment Added&quot;</expression>
    </formulas>
    <formulas>
        <name>Recipient</name>
        <dataType>String</dataType>
        <expression>{!$Record.Parent.Contact.Email}</expression>
    </formulas>
    <formulas>
        <name>TriggerCaseId</name>
        <dataType>String</dataType>
        <expression>{!$Record.ParentId}</expression>
    </formulas>
    <interviewLabel>Notify Contact On Case Comment Added {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Notify Contact On Case Comment Added</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_if_Case_Source_System_is_Customer_Portal</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsPublished</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>CaseComment</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Notify_Case_Contact</name>
        <label>Notify Case Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Send_Email_Notification_To_Customer_Portal</flowName>
        <inputAssignments>
            <name>EmailMessageDetail</name>
            <value>
                <elementReference>EmailMessageRecord</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <name>EmailBodyFormatted</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hi {!$Record.Parent.Contact.FirstName},&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The Case : {!$Record.Parent.CaseNumber} has new comment - {!$Record.CommentBody}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thanks,&lt;/p&gt;&lt;p&gt;VFS Support Team&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>EmailMessageRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>EmailMessage</objectType>
    </variables>
</Flow>
