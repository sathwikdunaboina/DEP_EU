<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>This flow sync the manual opportunity data to the manual factory order in order to create the correct quote for manual opportunity</description>
    <environments>Default</environments>
    <interviewLabel>Sync Opportunity Data For Quote {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sync Manual Opportunity Data For Quote</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_the_factory_order</name>
        <label>Update the factory order</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputAssignments>
            <field>Axle_Arrangement__c</field>
            <value>
                <elementReference>$Record.Lead_Axle_Arrangement__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Brand__c</field>
            <value>
                <elementReference>$Record.Lead_Brand__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Chassis_Type__c</field>
            <value>
                <elementReference>$Record.Lead_Chassis_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Dealer_Id__c</field>
            <value>
                <elementReference>$Record.Account.CustomerID__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Main_Dealer_Name__c</field>
            <value>
                <elementReference>$Record.Account.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Market_Type_1_5__c</field>
            <value>
                <elementReference>$Record.Lead_Model__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>VIN_Number__c</field>
            <value>
                <elementReference>$Record.Lead_VIN_Number__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Factory_Orders__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_the_factory_order</targetReference>
        </connector>
        <filterLogic>1 AND( 2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8)</filterLogic>
        <filters>
            <field>LeadSource</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Factory Order</stringValue>
            </value>
        </filters>
        <filters>
            <field>Factory_Order__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Lead_Axle_Arrangement__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Lead_Chassis_Type__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Lead_Model__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Lead_VIN_Number__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Lead_Brand__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
