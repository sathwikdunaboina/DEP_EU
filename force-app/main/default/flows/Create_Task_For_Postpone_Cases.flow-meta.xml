        <rules>
            <name>Outcome_1_of_Check_if_Task_Due_Date_Is_Equal_To_Case_Reopen_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record_Detail.Case_Reopen_Date__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Task_Record_For_Case.ActivityDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Case_Reopen_Date_To_Task_Due_Date</targetReference>
            </connector>
            <label>Outcome 1 of Check if Task Due Date Is Equal To Case Reopen Date</label>
        </rules>
    </decisions>
