    <decisions>
        <name>Check_Has_Attachment_Field_On_Case_and_Email_Message</name>
        <label>Check Has Attachment Field On Case and Email Message</label>
        <locationX>490</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Set_Case_s_Has_Attachment_Field_to_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Has_Attachment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.Has_Attachment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_s_Has_Attachment_Field_To_Yes</targetReference>
            </connector>
            <label>Set Case&apos;s Has Attachment Field to Yes</label>
        </rules>
        <rules>
            <name>Set_Case_s_Has_Attachment_Field_to_No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Has_Attachment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.Has_Attachment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_ContentDocumentLinks_Attached_to_Case</targetReference>
            </connector>
            <label>Set Case&apos;s Has Attachment Field to No</label>
        </rules>
        <rules>
            <name>Set_Case_s_Has_Attachment_Field_to_Default_No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Has_Attachment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.Has_Attachment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_s_Has_Attachment_Field_To_No</targetReference>
            </connector>
            <label>Set Case&apos;s Has Attachment Field to Default No</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Case_Have_any_ContentDocumentLinks</name>
        <label>Check If Case Have any ContentDocumentLinks</label>
        <locationX>446</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Update_Case_s_Has_Attachment_Field_To_No</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If ContentDocumentLink is Empty</defaultConnectorLabel>
        <rules>
            <name>If_ContentDocumentLink_is_Not_Empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_ContentDocumentLinks_Attached_to_Case</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_s_Has_Attachment_Field_as_Yes</targetReference>
            </connector>
            <label>If ContentDocumentLink is Not Empty</label>
        </rules>
    </decisions>
    <description>When an Email Message(with or without Attachment) is created or updated, if the Has Attachment Field is changed then it will update the corresponding Case record&apos;s Has Attachment field with Yes or No</description>
    <environments>Default</environments>
    <formulas>
        <name>CaseNeedsUpdate</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  AND(
    ISPICKVAL({!$Record.Has_Attachment__c} ,&quot;Yes&quot;),
    ISPICKVAL({!$Record.Parent.Has_Attachment__c} , &quot;No&quot;)
  ),
  AND(
    ISPICKVAL({!$Record.Has_Attachment__c}, &quot;N&quot;),
    ISPICKVAL({!$Record.Parent.Has_Attachment__c}, &quot;Yes&quot;)
  )
)</expression>
    </formulas>
    <interviewLabel>Update Has Attachment on Case when Email Message Create/Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Has Attachment Field on Case when Email Message Create/Update</label>
