    <decisions>
        <description>We doesn&apos;t have split function. So we check along with comma to make the logic is correct.</description>
        <name>Check_From_Address</name>
        <label>Check From Address</label>
        <locationX>182</locationX>
        <locationY>398</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AutoClose_From_Address</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>VerifyEmailIsConfigured</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Case_as_Closed</targetReference>
            </connector>
            <label>AutoClose From Address</label>
        </rules>
    </decisions>
    <formulas>
        <name>EmailsWithoutSpace</name>
        <dataType>String</dataType>
        <expression> SUBSTITUTE({!Get_AutoClose_Settings.From_Email_Address__c}, &quot; &quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>Because salesforce doesnt have split function, this logic does a detailed check to avoid errors of contains function. eg: abcd@gmail.com contains bcd@gmail.com. So we cant use contains function.</description>
        <name>VerifyEmailIsConfigured</name>
        <dataType>Boolean</dataType>
        <expression>{!Get_Case_Details.SuppliedEmail} != null 
&amp;&amp; {!EmailsWithoutSpace} != null 
&amp;&amp;(BEGINS ( {!EmailsWithoutSpace} , {!Get_Case_Details.SuppliedEmail}) 
|| CONTAINS (    {!EmailsWithoutSpace} , &quot;,&quot; &amp; {!Get_Case_Details.SuppliedEmail} ))</expression>
    </formulas>
