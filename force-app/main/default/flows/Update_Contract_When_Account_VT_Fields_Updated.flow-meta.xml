<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Customer_and_Dealer_Account</name>
        <label>Check Customer and Dealer Account</label>
        <locationX>578</locationX>
        <locationY>664</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsCustomer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Related_Contracts</targetReference>
            </connector>
            <label>IsCustomer</label>
        </rules>
        <rules>
            <name>IsDealer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Dealer Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contracts_based_on_dealer_Account</targetReference>
            </connector>
            <label>IsDealer</label>
        </rules>
    </decisions>
    <description>This flow updates the Contracts which is related to triggered Account.</description>
    <environments>Default</environments>
    <formulas>
        <name>CurrentDateTime</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Update Contract When Account VT Fields Updated {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Contract When Account VT Fields Updated</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Contracts_based_on_dealer_Account</name>
        <label>Update Contracts based on dealer Account</label>
        <locationX>265</locationX>
        <locationY>609</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DealerId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Customer_Code__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>End_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>CurrentDateTime</elementReference>
            </value>
        </filters>
        <filters>
            <field>Business_Area__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>VT</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>VTContext_LastModifiedDate__c</field>
            <value>
                <elementReference>CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Contract__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Related_Contracts</name>
        <label>Update Related Contracts</label>
        <locationX>910</locationX>
        <locationY>611</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>End_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>CurrentDateTime</elementReference>
            </value>
        </filters>
        <filters>
            <field>Business_Area__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>VT</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>VTContext_LastModifiedDate__c</field>
            <value>
                <elementReference>CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Contracts__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>284</locationX>
        <locationY>50</locationY>
        <filterFormula>IF(AND({!$Record.RecordType.Name}==&apos;Dealer Account&apos;,ISCHANGED({!$Record.OwnerId}),!ISNULL({!$Record.CustomerID__c})), true, 
IF(AND({!$Record.RecordType.Name}==&apos;Customer Account&apos;,ISCHANGED({!$Record.Name})), true, false))</filterFormula>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>Scheduled_After_LastModifiedDate</name>
            <connector>
                <targetReference>Check_Customer_and_Dealer_Account</targetReference>
            </connector>
            <label>Scheduled_After_LastModifiedDate</label>
            <maxBatchSize>2</maxBatchSize>
            <offsetNumber>5</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>LastModifiedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
