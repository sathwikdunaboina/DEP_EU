    <description>Assign Primary Customer fields on before create/update event. Gets primary customer field(VFS Customer Number/Company Identification number) information from account and assigns to credit line. Validate if information is not available at account then user manually adds it.</description>
    <environments>Default</environments>
    <formulas>
        <name>CompanyIdentificationNumber</name>
        <dataType>String</dataType>
        <expression>IF( {!CompanyIdentificationNumberAccount} != &apos;&apos; , {!CompanyIdentificationNumberAccount}     ,  {!$Record.CLA_Company_Identification_Number__c}   )</expression>
    </formulas>
    <formulas>
        <name>CompanyIdentificationNumberAccount</name>
        <dataType>String</dataType>
        <expression>CASE( TEXT( {!$Record.CLA_Country__c}) , &apos;ES&apos;,  {!Get_Account.VATNumber__c} ,
                                                                  &apos;BE&apos;, {!Get_Account.VATNumber__c} , 
                                                                   &apos;DE&apos;  ,{!Get_Account.Customer_Number__c} , 
                                                                   &apos;CH&apos; ,{!Get_Account.Customer_Number__c}  , 
                                                                   &apos;AT&apos; ,{!Get_Account.Customer_Number__c} , 
                                                                   &apos;DK&apos; , {!Get_Account.CompanyRegistrationNumber__c},
   &apos;LV&apos; , {!Get_Account.CompanyRegistrationNumber__c} , 
   &apos;LT&apos; , {!Get_Account.CompanyRegistrationNumber__c}  , 
   &apos;EE&apos; , {!Get_Account.CompanyRegistrationNumber__c} , 
    &apos;FI&apos; , {!Get_Account.CompanyRegistrationNumber__c},
    &apos;NL&apos; , {!Get_Account.CompanyRegistrationNumber__c},
    &apos;SE&apos; , {!Get_Account.CompanyRegistrationNumber__c},
    &apos;NO&apos; , {!Get_Account.CompanyRegistrationNumber__c},
   &apos;GB&apos; , {!Get_Account.CompanyRegistrationNumber__c},
    &apos;IT&apos; , {!Get_Account.CompanyRegistrationNumber__c},
     &apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>ISNEW</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>PrimaryCustomerName</name>
        <dataType>String</dataType>
        <expression>IF( NOT (  ISBLANK(  {!Get_Account.Name} ) )  ,   {!Get_Account.Name}, {!$Record.CLA_Primary_Customer_Name__c})</expression>
    </formulas>
    <formulas>
        <name>VFSCustomerNumber</name>
        <dataType>String</dataType>
        <expression>IF(   NOT( ISBLANK({!Get_Account.Customer_Number__c}) )  , {!Get_Account.Customer_Number__c}  , {!$Record.CLA_VFS_Customer_Number__c})</expression>
    </formulas>
