        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_is_Approved_Suspended_Expiry</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Credit_Line_Record.CLA_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
