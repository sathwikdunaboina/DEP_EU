<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_OTP</name>
        <label>Send OTP</label>
        <locationX>649</locationX>
        <locationY>64</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Email_Sent</targetReference>
        </connector>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>EmailBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>UserEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Code for login</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Generate_OTP</name>
        <label>Generate OTP</label>
        <locationX>493</locationX>
        <locationY>61</locationY>
        <assignmentItems>
            <assignToReference>OTPValue</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>GenerateOTPString</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_OTP</targetReference>
        </connector>
    </assignments>
    <constants>
        <description>This is used in case if Email doesnt work / any urgency / issue with the flow. If we dont have this, then all admins will be locked out and Salesforce will be unreachable.</description>
        <name>MasterKey</name>
        <dataType>String</dataType>
        <value>
            <stringValue>1401</stringValue>
        </value>
    </constants>
    <formulas>
        <name>GenerateOTPString</name>
        <dataType>String</dataType>
        <expression>TEXT(MOD( 
Round (((NOW()-{!$System.OriginDateTime}) * 864) ^ 2 , 0)
, 100000))</expression>
    </formulas>
    <formulas>
        <name>MaskedEmail</name>
        <dataType>String</dataType>
        <expression>LEFT({!$User.Email},3) &amp; &quot;xxxxxx&quot; &amp;  RIGHT({!$User.Email}, ( LEN ({!$User.Email}) - Find(&quot;@&quot;, {!$User.Email}) +1 ) )</expression>
    </formulas>
    <formulas>
        <name>UserEmail</name>
        <dataType>String</dataType>
        <expression>{!$User.Email}</expression>
    </formulas>
    <interviewLabel>Login OTP {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Login OTP</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Email_Sent</name>
        <label>Email Sent</label>
        <locationX>648</locationX>
        <locationY>218</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>EnterOTPValue</name>
            <fieldText>&lt;p&gt;Ola Admin!&lt;/p&gt;&lt;p&gt;We have sent a code to your email address {!MaskedEmail}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Code</name>
            <dataType>String</dataType>
            <fieldText>Code</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Code is sent to your email.&lt;/p&gt;</helpText>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;Invalid code !!&lt;/p&gt;</errorMessage>
                <formulaExpression>{!Code} == {!OTPValue} ||  {!Code} == {!MasterKey}</formulaExpression>
            </validationRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Generate_OTP</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>EmailBody</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Hi, Please use the below code to login to Salesforce.    {!OTPValue}</stringValue>
        </value>
    </variables>
    <variables>
        <name>OTPValue</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
