        <label>UK /IE Sharing Rule</label>
        <sharedTo>
            <roleAndSubordinatesInternal>UK_IE</roleAndSubordinatesInternal>
        </sharedTo>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>Country__c</field>
            <operation>equals</operation>
