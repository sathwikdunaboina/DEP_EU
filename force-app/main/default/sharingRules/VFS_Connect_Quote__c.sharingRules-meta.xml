<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>DE_Sharing_Rule</fullName>
        <accessLevel>Read</accessLevel>
        <description>This is sharing rule for German Market</description>
        <label>DE Sharing Rule</label>
        <sharedTo>
            <roleAndSubordinatesInternal>DE_Managing_Director</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>Country__c</field>
            <operation>equals</operation>
            <value>DE</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>France_Quote_Sharing</fullName>
