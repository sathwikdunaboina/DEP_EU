<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>AT_CustomerService_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Grant Read/Write access to AT Cases. To customer service agents of AT Market.</description>
        <label>AT CustomerService Access</label>
        <sharedTo>
            <group>Austria_CustomerService</group>
        </sharedTo>
        <criteriaItems>
            <field>Country__c</field>
            <operation>equals</operation>
            <value>Austria</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
