    <sharingCriteriaRules>
        <fullName>CLA_AT_Market_Record_Sharing_Rule</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Provides Read/Write access of Credit Line with country AT with members of Credit Line AT Group.</description>
        <label>CLA AT Market Record Sharing Rule</label>
        <sharedTo>
            <group>CLA_Credit_Line_AT</group>
        </sharedTo>
        <criteriaItems>
            <field>CLA_Country__c</field>
            <operation>equals</operation>
            <value>AT</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
