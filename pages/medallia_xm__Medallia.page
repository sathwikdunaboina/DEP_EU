<apex:page sidebar="false">

<apex:iframe id="iframe" src="{!IF(ISBLANK($Setup.medallia_xm__Medallia_Settings__c.medallia_xm__Tab_URL__c), 'https://www.medallia.com', $Setup.medallia_xm__Medallia_Settings__c.medallia_xm__Tab_URL__c)}" scrolling="true"/>

<script>
(function() {
	var windowOnresize = window.onresize;

	window.onresize = function() {
		// Don't trample existing handler; intercept it.
		if (windowOnresize) {
			windowOnresize();
		}

		setIframeHeight();
	};

	function setIframeHeight() {
		document.getElementById('iframe').height = window.innerHeight - 20;
	}

    setIframeHeight();
}());
</script>

</apex:page>