<apex:page standardController="Account" extensions="medallia_xm.MedAddToProgramDialogControllerListAct,medallia_xm.LightningOutExtension" recordSetVar="accounts" label="Medallia Add To Program Dialog Detail" >
  <apex:includeLightning />
  <apex:includeScript value="/lightning/lightning.out.js" />
  <div id="myDivId"></div>
  <style>
    body,
    html {
      padding: 0!important;
    }
  </style>
  <script>
    var selectedIds = "{! JSENCODE(PersonContactIds) }";
    var parsedIds = JSON.parse(selectedIds);
    var personAccountsEnabled = JSON.parse("{! JSENCODE(personAccountsEnabled) }");

    var classicAccountUrl = '{!URLFOR($Action.Account.List, $ObjectType.Account)}';

    // Determine Classic or Lightning Experience
    var isLightning = typeof sforce !== 'undefined' && sforce.one && true;

    $Lightning.use("{!ns}:MedAddToProgramDialogApp", function () {
      //$Lightning.createComponent(String type, Object attributes, String locator, function callback) */
      $Lightning.createComponent("{!ns}:MedAddToProgramDialog",
        {
          view: 'list',
          selectedIds: parsedIds,
          isLightning: isLightning,
          origin: 'Account',
          personAccountsEnabled: personAccountsEnabled,
          classicOriginUrl: classicAccountUrl
        },
        "myDivId",
        function (component) {
          // supporting setup
        });
    });
  </script>
</apex:page>