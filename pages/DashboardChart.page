<apex:page applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" showHeader="false" standardStylesheets="false" controller="DashboardChartController">  
    <html>
        <head>
            <style>
                #JSFiddle {
                position: relative;
                
                }
                
                .overlay-label{
                display: block;
                background-color: white;
                width: 31px;
                height: 24px;
                text-align: center;
                vertical-align: middle;
                position: absolute;
                top: 24px;
                left: 85px;
                color:{!totalcountColor};
                font-family:Helvetica;
                margin-top: 55px;
                font-size: 30px;
                font-weight: 700;
                }
                
                .overlay-label-noContracts{
                display: block;
                background-color: white;
                height: 24px;
                text-align: center;
                vertical-align: middle;
                position: absolute;
                top: 24px;
                color:{!totalcountColor};
                font-family:Helvetica;
                margin-top: 55px;
                font-size: 10px;
                font-weight: 700;
                }
            </style>
            <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
            <script type="text/javascript">
                
            google.charts.load('current', {'packages':['corechart']});
            google.charts.setOnLoadCallback(drawChart);
            
            function drawChart() {
                //var lexOrigin ={!urlforvf};
                // alert('drwahart--');
                // alert(document.getElementById('theHiddenInput').value)
                var data = google.visualization.arrayToDataTable([{!retrunString} ]);

                var options = {'title':'',
                               colors: {!colors},
                               pieHole: 0.6,
                               legend: {position: 'none'},
                               pieSliceText: 'value',
                               tooltip: {
                                   trigger:'none'
                               },
                               chartArea:{left:10,top:10,width:'90%',height:'90%'},
                               pieSliceTextStyle: {
                                   colors: '["#808080","#808080","#06536a"]',
                               },
                              };
                
                // Instantiate and draw our chart, passing in some options.
                var chart = new google.visualization.PieChart(document.getElementById('chart_div'));
                chart.draw(data, options);
                
                function selectHandler() {
                    // var lexOrigin ='https://infosys-custpoc.cs96.force.com';
                    var lexOrigin= document.getElementById('theHiddenInput').value;
                    //var lexOrigin =url;
                    var selectedItem = chart.getSelection()[0];
                    if (selectedItem) {
                        var topping = data.getValue(selectedItem.row, 0);
                        parent.postMessage(topping, lexOrigin);
                    }
                }
                
                google.visualization.events.addListener(chart, 'select', selectHandler);    
                chart.draw(data, options);
                google.visualization.events.addListener(chart, 'onmouseover', function(e) {
                    document.getElementById('chart_div').style.cursor = 'pointer';
                });
            }
            </script>
            
        </head>
        <body>
            <input type="hidden" value="{!urlforvf}" id="theHiddenInput" />
            <div id="JSFiddle">
                <div id="chart_div"></div>
                <div id="cnt" class="overlay"></div>
                <div class="{!IF(totalContract != 0,'overlay-label','overlay-label-noContracts')}">{!IF((totalContract == 0),$Label.No_Contracts, totalContract)}</div>
            </div>
        </body>
    </html>
</apex:page>